<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds the offline dictionary file (one read-only SQLite file) from the JSON shards tools/build_dict.py writes. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Lamha.Tools.DictionaryBuilder</RootNamespace>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lamha.Data\Lamha.Data.csproj" />
  </ItemGroup>
</Project>
