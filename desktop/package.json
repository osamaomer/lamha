{
  "name": "lamha-desktop",
  "productName": "Lamha",
  "version": "1.9.7",
  "description": "Lamha — لمحة: Arabic-first dictionary, translator, writing tools and word review for Windows",
  "author": "Artwork Lab",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "node scripts/run.mjs",
    "smoke": "node scripts/run.mjs --smoke-test",
    "shots": "node scripts/run.mjs --screenshots",
    "icons": "node scripts/run.mjs scripts/make-icons.js",
    "sync": "node scripts/sync-ext.mjs",
    "dist": "npm run sync && electron-builder --win",
    "release": "npm run sync && electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.artworklab.lamha",
    "productName": "Lamha",
    "files": [
      "main.js",
      "storage.js",
      "preload.js",
      "native.js",
      "selection.js",
      "clipboard-monitor.js",
      "clipboard-store.js",
      "clipboard-actions.js",
      "clipboard-privacy.js",
      "uia-context.js",
      "double-click.js",
      "app-rules.js",
      "pack-store.js",
      "zim.js",
      "wiki-library.js",
      "native-bridge.js",
      "updater.js",
      "renderer/**",
      "assets/**",
      "ext/**",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "osamaomer",
        "repo": "lamha",
        "releaseType": "draft"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon-256.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Lamha",
      "artifactName": "Lamha-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Lamha-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.1"
  }
}
