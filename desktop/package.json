{
  "name": "lamha-desktop",
  "productName": "Lamha",
  "version": "1.5.0",
  "description": "Lamha — لمحة: Arabic-first dictionary, translator, writing tools and word review for Windows",
  "author": "Artwork Lab",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "node scripts/run.mjs",
    "smoke": "node scripts/run.mjs --smoke-test",
    "icons": "node scripts/run.mjs scripts/make-icons.js",
    "sync": "node scripts/sync-ext.mjs",
    "dist": "npm run sync && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.artworklab.lamha",
    "productName": "Lamha",
    "files": [
      "main.js",
      "storage.js",
      "preload.js",
      "native.js",
      "selection.js",
      "clipboard-monitor.js",
      "clipboard-store.js",
      "clipboard-actions.js",
      "clipboard-privacy.js",
      "renderer/**",
      "assets/**",
      "ext/**",
      "scripts/smoke-test.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon-256.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Lamha",
      "artifactName": "Lamha-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Lamha-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "koffi": "^3.3.1"
  }
}
