<Window
    x:Class="Lamha.App.Windows.FirstRunWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Lamha.App.Controls"
    xmlns:main="using:Lamha.App.ViewModels.Main"
    xmlns:views="using:Lamha.App.Views">
  <!-- Phase 1's first-run window (docs/design/first-run.html): 640 × 540, Mica, its own title bar, and one step at a
       time on Windows' content layer: the steps in a row at the top, the step, and its buttons at the foot -->
  <Grid x:Name="Root">
    <Grid.Resources>
      <!-- Keys as the design draws them: key caps (12 px, the chip's fill, a line under) joined by "+" -->
      <DataTemplate x:Key="KeyPartTemplate" x:DataType="main:KeyPart">
        <Grid>
          <Border Padding="7,2" CornerRadius="6" Background="{ThemeResource LamhaSurfaceBrush}" BorderBrush="{ThemeResource LamhaLineBrush}" BorderThickness="1,1,1,2"
                  Visibility="{x:Bind IsKey}">
            <TextBlock FontSize="12" Foreground="{ThemeResource LamhaTextBrush}" Text="{x:Bind Text}" />
          </Border>
          <TextBlock Margin="2,0" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource LamhaTextMutedBrush}" Text="{x:Bind Text}"
                     Visibility="{x:Bind controls:Show.IfNot(IsKey)}" />
        </Grid>
      </DataTemplate>
      <ItemsPanelTemplate x:Key="KeysPanel">
        <StackPanel Orientation="Horizontal" Spacing="2" FlowDirection="LeftToRight" />
      </ItemsPanelTemplate>
      <Style x:Key="StepTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource LamhaTextStyle}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="29" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextReadingOrder" Value="UseFlowDirection" />
      </Style>
      <Style x:Key="LeadStyle" TargetType="TextBlock" BasedOn="{StaticResource LamhaTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeBody}" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="Foreground" Value="{ThemeResource LamhaTextMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextReadingOrder" Value="UseFlowDirection" />
        <Setter Property="MaxWidth" Value="470" />
        <Setter Property="HorizontalAlignment" Value="Left" />
      </Style>
      <!-- The design's boxes: the surface, a 1 px line, 10 px corners -->
      <Style x:Key="BoxStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LamhaSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LamhaLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource LamhaRadiusMedium}" />
        <Setter Property="Padding" Value="16,4" />
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Lamha's page colour instead of Mica (Settings → Appearance → the wallpaper behind the window) -->
    <Border x:Name="Solid" Grid.RowSpan="2" Background="{ThemeResource LamhaPageBrush}" Visibility="Collapsed" />

    <!-- The title bar: Lamha's mark and name; Windows draws the minimise and close buttons at its end -->
    <Grid x:Name="TitleBar" Padding="16,0,0,0" Background="Transparent">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Border Width="16" Height="16" CornerRadius="4" Background="{ThemeResource LamhaBrandBrush}">
          <controls:LineIcon Glyph="Translate" Width="10" Height="10" StrokeWidth="2.8" Foreground="White" />
        </Border>
        <TextBlock VerticalAlignment="Center" Style="{StaticResource LamhaCaptionTextStyle}" Foreground="{ThemeResource LamhaTextBrush}" Text="{x:Bind ViewModel.Lamha}" />
      </StackPanel>
    </Grid>

    <!-- The step, on Windows' content layer over Mica, 8 px in from the window's edges -->
    <Border Grid.Row="1" Margin="8,0,8,8" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The steps: a number in a 20 px circle and the name, joined by lines; done ones checked, this one filled -->
        <Grid x:Name="StepRow" Margin="28,16,28,0" ColumnSpacing="8" />

        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
          <Grid Padding="28,24,28,4">

            <!-- ===== 1. Welcome and the interface language ===== -->
            <StackPanel x:Name="LanguageStep" Visibility="{x:Bind ViewModel.IsLanguage, Mode=OneWay}" Spacing="12">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="56" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="56" Height="56" VerticalAlignment="Center" CornerRadius="{StaticResource LamhaRadiusLarge}" Background="{ThemeResource LamhaBrandBrush}">
                  <controls:LineIcon Glyph="Translate" Width="30" Height="30" StrokeWidth="2.2" Foreground="White" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource StepTitleStyle}" Text="{x:Bind ViewModel.Welcome}" AutomationProperties.HeadingLevel="Level1" />
                  <TextBlock Style="{StaticResource LeadStyle}" Text="{x:Bind ViewModel.Hero}" />
                </StackPanel>
              </Grid>
              <StackPanel Margin="0,8,0,0">
                <TextBlock TextReadingOrder="UseFlowDirection" Style="{StaticResource LamhaTextStyle}" FontSize="{StaticResource LamhaFontSizeBody}" FontWeight="SemiBold"
                           Text="{x:Bind ViewModel.UiLang}" />
                <TextBlock TextReadingOrder="UseFlowDirection" Style="{StaticResource LamhaCaptionTextStyle}" Text="{x:Bind ViewModel.UiLangHint}" />
              </StackPanel>
              <!-- The two languages as choices, each in its own name; the chosen one ringed in the button colour -->
              <Grid Margin="0,4,0,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid>
                  <Border Style="{StaticResource BoxStyle}" Padding="0" />
                  <Border BorderBrush="{ThemeResource LamhaButtonBrush}" BorderThickness="2" CornerRadius="{StaticResource LamhaRadiusMedium}"
                          Visibility="{x:Bind ViewModel.IsArabic, Mode=OneWay}" />
                  <RadioButton x:Name="ArabicChoice" GroupName="UiLang" Style="{StaticResource LamhaRadioStyle}" Padding="16,14" FocusVisualMargin="0"
                               IsChecked="{x:Bind ViewModel.IsArabic, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.Arabic}">
                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource LamhaTextBrush}" Text="{x:Bind ViewModel.Arabic}" />
                  </RadioButton>
                </Grid>
                <Grid Grid.Column="1">
                  <Border Style="{StaticResource BoxStyle}" Padding="0" />
                  <Border BorderBrush="{ThemeResource LamhaButtonBrush}" BorderThickness="2" CornerRadius="{StaticResource LamhaRadiusMedium}"
                          Visibility="{x:Bind ViewModel.IsEnglish, Mode=OneWay}" />
                  <RadioButton x:Name="EnglishChoice" GroupName="UiLang" Style="{StaticResource LamhaRadioStyle}" Padding="16,14" FocusVisualMargin="0"
                               IsChecked="{x:Bind ViewModel.IsEnglish, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.English}">
                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource LamhaTextBrush}" Text="{x:Bind ViewModel.English}" />
                  </RadioButton>
                </Grid>
              </Grid>
            </StackPanel>

            <!-- ===== 2. Try it: select a word in the sentence and press the shortcut; the real card opens ===== -->
            <StackPanel x:Name="TryStep" Visibility="{x:Bind ViewModel.IsTry, Mode=OneWay}" Spacing="12">
              <TextBlock Style="{StaticResource StepTitleStyle}" Text="{x:Bind ViewModel.TryTitle}" AutomationProperties.HeadingLevel="Level1" />
              <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind controls:Show.IfNot(ViewModel.Tried), Mode=OneWay}">
                <TextBlock VerticalAlignment="Center" TextReadingOrder="UseFlowDirection" Style="{StaticResource LamhaTextStyle}" FontSize="{StaticResource LamhaFontSizeBody}"
                           Text="{x:Bind ViewModel.TryText}" />
                <ItemsControl VerticalAlignment="Center" IsTabStop="False" ItemsSource="{x:Bind ViewModel.LookupKeys, Mode=OneWay}"
                              ItemTemplate="{StaticResource KeyPartTemplate}" ItemsPanel="{StaticResource KeysPanel}" />
              </StackPanel>
              <!-- Once the card has opened on it: the design's green line -->
              <Border Padding="12,10" CornerRadius="{StaticResource LamhaRadiusMedium}" Background="{ThemeResource LamhaOkSoftBrush}"
                      Visibility="{x:Bind ViewModel.Tried, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <controls:LineIcon Glyph="Check" Width="16" Height="16" StrokeWidth="2.6" VerticalAlignment="Center" Foreground="{ThemeResource LamhaOkBrush}" />
                  <TextBlock VerticalAlignment="Center" TextReadingOrder="UseFlowDirection" Style="{StaticResource LamhaTextStyle}" FontSize="13.5" FontWeight="SemiBold"
                             Foreground="{ThemeResource LamhaOkBrush}" Text="{x:Bind ViewModel.TryOk}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource BoxStyle}" Padding="20">
                <TextBlock x:Name="SampleText" FlowDirection="LeftToRight" FontFamily="Georgia" FontSize="18" LineHeight="29" TextWrapping="Wrap"
                           Foreground="{ThemeResource LamhaTextBrush}" IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.Sample}" />
              </Border>
              <Border Style="{StaticResource BoxStyle}">
                <StackPanel>
                  <Grid Padding="0,10" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" TextReadingOrder="UseFlowDirection" Style="{StaticResource LamhaTextStyle}" FontSize="{StaticResource LamhaFontSizeBody}"
                               Text="{x:Bind ViewModel.HkWrite}" />
                    <ItemsControl Grid.Column="1" VerticalAlignment="Center" IsTabStop="False" ItemsSource="{x:Bind ViewModel.WriteKeys, Mode=OneWay}"
                                  ItemTemplate="{StaticResource KeyPartTemplate}" ItemsPanel="{StaticResource KeysPanel}" />
                  </Grid>
                  <Border Height="1" Background="{ThemeResource LamhaLineBrush}" />
                  <Grid Padding="0,10" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" TextReadingOrder="UseFlowDirection" Style="{StaticResource LamhaTextStyle}" FontSize="{StaticResource LamhaFontSizeBody}"
                               Text="{x:Bind ViewModel.HkClip}" />
                    <ItemsControl Grid.Column="1" VerticalAlignment="Center" IsTabStop="False" ItemsSource="{x:Bind ViewModel.ClipboardKeys, Mode=OneWay}"
                                  ItemTemplate="{StaticResource KeyPartTemplate}" ItemsPanel="{StaticResource KeysPanel}" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- ===== 3. The writing tools, optional: Settings' five providers ===== -->
            <StackPanel x:Name="WritingStep" Visibility="{x:Bind ViewModel.IsWriting, Mode=OneWay}" Spacing="12">
              <TextBlock Style="{StaticResource StepTitleStyle}" Text="{x:Bind ViewModel.WritingTitle}" AutomationProperties.HeadingLevel="Level1" />
              <TextBlock Style="{StaticResource LeadStyle}" Text="{x:Bind ViewModel.AiText}" />
              <views:WritingSetupView Setup="{x:Bind ViewModel.Writing}" />
            </StackPanel>

            <!-- ===== 4. Ready: Start with Windows (on) and clipboard history (off unless turned on) ===== -->
            <StackPanel x:Name="ReadyStep" Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay}" Spacing="12">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="56" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="56" Height="56" VerticalAlignment="Center" CornerRadius="{StaticResource LamhaRadiusLarge}" Background="{ThemeResource LamhaBrandBrush}">
                  <controls:LineIcon Glyph="Check" Width="30" Height="30" StrokeWidth="2.2" Foreground="White" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource StepTitleStyle}" Text="{x:Bind ViewModel.ReadyTitle}" AutomationProperties.HeadingLevel="Level1" />
                  <!-- The line ends with the lookup's keys, as the design writes them -->
                  <RichTextBlock MaxWidth="470" HorizontalAlignment="Left" TextReadingOrder="UseFlowDirection" FontFamily="{StaticResource LamhaFontFamily}"
                                 FontSize="{StaticResource LamhaFontSizeBody}" LineHeight="24" Foreground="{ThemeResource LamhaTextMutedBrush}" IsTextSelectionEnabled="False">
                    <Paragraph>
                      <Run Text="{x:Bind ViewModel.ReadyText}" />
                      <InlineUIContainer>
                        <ItemsControl Margin="0,0,0,-5" IsTabStop="False" ItemsSource="{x:Bind ViewModel.LookupKeys, Mode=OneWay}"
                                      ItemTemplate="{StaticResource KeyPartTemplate}" ItemsPanel="{StaticResource KeysPanel}" />
                      </InlineUIContainer>
                    </Paragraph>
                  </RichTextBlock>
                </StackPanel>
              </Grid>
              <Border Margin="0,8,0,0" Style="{StaticResource BoxStyle}">
                <StackPanel>
                  <Grid Padding="0,10" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock TextReadingOrder="UseFlowDirection" Style="{StaticResource LamhaTextStyle}" FontSize="{StaticResource LamhaFontSizeBody}" Text="{x:Bind ViewModel.Login}" />
                      <TextBlock TextReadingOrder="UseFlowDirection" Style="{StaticResource LamhaCaptionTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.LoginHint}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource LamhaSettingsSwitchStyle}" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Bind ViewModel.Login}" />
                  </Grid>
                  <Border Height="1" Background="{ThemeResource LamhaLineBrush}" />
                  <Grid Padding="0,10" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock TextReadingOrder="UseFlowDirection" Style="{StaticResource LamhaTextStyle}" FontSize="{StaticResource LamhaFontSizeBody}" Text="{x:Bind ViewModel.Clip}" />
                      <TextBlock TextReadingOrder="UseFlowDirection" Style="{StaticResource LamhaCaptionTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.ClipHint}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource LamhaSettingsSwitchStyle}" IsOn="{x:Bind ViewModel.ClipboardOn, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Bind ViewModel.Clip}" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>

        <!-- The buttons: Customise shortcuts at the start on Try it; Back, Later and Next (or Start) at the end -->
        <Grid Grid.Row="2" Padding="28,16,28,20" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Style="{StaticResource LamhaQuietButtonStyle}" Margin="-8,0,0,0" Padding="8,6" Background="Transparent" FontWeight="Normal"
                  Foreground="{ThemeResource LamhaTextMutedBrush}" Content="{x:Bind ViewModel.CustomizeLabel}" Command="{x:Bind ViewModel.CustomizeCommand}"
                  Visibility="{x:Bind ViewModel.IsTry, Mode=OneWay}" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
            <Button Style="{StaticResource LamhaQuietButtonStyle}" Content="{x:Bind ViewModel.BackLabel}" Command="{x:Bind ViewModel.BackCommand}"
                    Visibility="{x:Bind controls:Show.IfNot(ViewModel.IsLanguage), Mode=OneWay}" />
            <Button Style="{StaticResource LamhaQuietButtonStyle}" Content="{x:Bind ViewModel.LaterLabel}" Command="{x:Bind ViewModel.LaterCommand}"
                    Visibility="{x:Bind ViewModel.IsWriting, Mode=OneWay}" />
            <Button x:Name="NextButton" Style="{StaticResource LamhaButtonStyle}" Content="{x:Bind ViewModel.NextLabel}" Command="{x:Bind ViewModel.NextCommand}"
                    Visibility="{x:Bind controls:Show.IfNot(ViewModel.IsReady), Mode=OneWay}" />
            <Button x:Name="StartButton" Style="{StaticResource LamhaButtonStyle}" Content="{x:Bind ViewModel.StartLabel}" Command="{x:Bind ViewModel.StartCommand}"
                    Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
