<Window
    x:Class="Lamha.App.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Lamha.App.Controls">
  <!-- The main window, as Windows' Settings (docs/design/system.md, The window; decision 0020): Mica, Windows' title bar
       with Back (and ☰ when narrow), Windows' navigation pane with Lamha's coloured icons, and the page on Windows' content
       layer, which NavigationView draws. Two widths only, as Settings: the pane open, or hidden behind ☰. -->
  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBackKey" />
    </Grid.KeyboardAccelerators>

    <!-- Lamha's page colour instead of Mica (Settings → Appearance → the wallpaper behind the window) -->
    <Border x:Name="Solid" Grid.RowSpan="2" Background="{ThemeResource LamhaPageBrush}" Visibility="Collapsed" />

    <!-- Windows' title bar: Back, ☰ when the pane is hidden, Lamha's mark and name; Windows' buttons at its end -->
    <TitleBar x:Name="AppTitleBar" IsBackButtonVisible="True" IsBackButtonEnabled="False"
              IsPaneToggleButtonVisible="False" BackRequested="OnBackRequested" PaneToggleRequested="OnPaneToggleRequested">
      <!-- The mark and the name as one header, 16 apart as Windows' icon and title, whatever the title bar's state -->
      <TitleBar.LeftHeader>
        <StackPanel Margin="{StaticResource LamhaTitleBarMarkMargin}" Orientation="Horizontal" Spacing="{StaticResource LamhaSpace4}" VerticalAlignment="Center">
          <controls:BrandMark VerticalAlignment="Center" />
          <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Lamha}" />
        </StackPanel>
      </TitleBar.LeftHeader>
    </TitleBar>

    <!-- Windows' navigation: open at 300, hidden behind ☰ below LamhaPaneHideWidth; Back and ☰ live in the title bar -->
    <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Auto" OpenPaneLength="{StaticResource LamhaPaneWidth}"
                    CompactModeThresholdWidth="{StaticResource LamhaPaneHideWidth}" ExpandedModeThresholdWidth="{StaticResource LamhaPaneHideWidth}"
                    IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" IsSettingsVisible="False" IsTitleBarAutoPaddingEnabled="False"
                    SelectionChanged="OnNavChanged" DisplayModeChanged="OnDisplayModeChanged">
      <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
          <!-- The page, 28 from each side (Settings' padding) and up to 1000 wide -->
          <StackPanel x:Name="PageFrame" MaxWidth="{StaticResource LamhaPageMaxWidth}" HorizontalAlignment="Stretch" Padding="{StaticResource LamhaPageMargin}"
                      Spacing="{StaticResource LamhaSpace4}">
            <TextBlock Style="{StaticResource LamhaPageTitleTextStyle}" Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                       AutomationProperties.HeadingLevel="Level1" Visibility="{x:Bind ViewModel.ShowsTitle, Mode=OneWay}" />
            <ContentPresenter x:Name="PageHost" HorizontalContentAlignment="Stretch" />
          </StackPanel>
        </ScrollViewer>

        <!-- "Copied", "History cleared · Undo": a moment at the foot of the page (Lamha 2's flash) -->
        <Border x:Name="ToastBox" Margin="{StaticResource LamhaToastMargin}" Padding="14,6" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                controls:Pill.IsPill="True" Background="{ThemeResource LamhaToastBackgroundBrush}"
                Visibility="{x:Bind controls:Show.IfText(ViewModel.Toast), Mode=OneWay, FallbackValue=Collapsed}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource LamhaSpace3}">
            <TextBlock VerticalAlignment="Center" FontSize="{StaticResource LamhaFontSizeCaption}" FontWeight="SemiBold" Foreground="{ThemeResource LamhaToastTextBrush}"
                       Text="{x:Bind ViewModel.Toast, Mode=OneWay}" AutomationProperties.LiveSetting="Polite" />
            <HyperlinkButton Style="{StaticResource LamhaLinkButtonStyle}" Command="{x:Bind ViewModel.RunToastActionCommand}"
                             Visibility="{x:Bind controls:Show.IfText(ViewModel.ToastAction), Mode=OneWay, FallbackValue=Collapsed}">
              <TextBlock FontWeight="Bold" Foreground="{ThemeResource LamhaToastActionBrush}" Text="{x:Bind ViewModel.ToastAction, Mode=OneWay}" />
            </HyperlinkButton>
          </StackPanel>
        </Border>

        <!-- The day's goal reached: Lamha 2's burst of letters from the toast, over the page (left to right: the code places it) -->
        <Canvas x:Name="BurstLayer" FlowDirection="LeftToRight" IsHitTestVisible="False" />
      </Grid>
    </NavigationView>
  </Grid>
</Window>
