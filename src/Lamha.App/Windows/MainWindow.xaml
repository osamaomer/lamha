<Window
    x:Class="Lamha.App.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Lamha.App.Controls"
    xmlns:main="using:Lamha.App.ViewModels.Main">
  <!-- Phase 1's main window: Mica, its own title bar, the pages on the start side, the page on Windows' content layer -->
  <Grid x:Name="Root" SizeChanged="OnRootSizeChanged">
    <Grid.Resources>
      <DataTemplate x:Key="NavItemTemplate" x:DataType="main:NavItem">
        <Grid ColumnSpacing="16" ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <controls:LineIcon Glyph="{x:Bind Glyph}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind Label}" />
        </Grid>
      </DataTemplate>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- The title bar: Lamha's mark and name; Windows draws the minimise, maximise and close buttons at its end -->
    <Grid x:Name="TitleBar" Padding="16,0,0,0" Background="Transparent">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Border Width="16" Height="16" CornerRadius="4" Background="{ThemeResource LamhaBrandBrush}">
          <controls:LineIcon Glyph="Translate" Width="10" Height="10" StrokeWidth="2.8" Foreground="White" />
        </Border>
        <TextBlock VerticalAlignment="Center" Style="{StaticResource LamhaCaptionTextStyle}" Foreground="{ThemeResource LamhaTextBrush}" Text="{x:Bind Lamha}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="PaneColumn" Width="260" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- The pages, and Settings at the foot -->
      <Grid Padding="0,4,0,8">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ListView x:Name="PageList" ItemsSource="{x:Bind ViewModel.Pages}" SelectionMode="Single" IsItemClickEnabled="False"
                  ItemContainerStyle="{StaticResource LamhaNavItemStyle}" ItemTemplate="{StaticResource NavItemTemplate}"
                  AutomationProperties.Name="{x:Bind Lamha}" SelectionChanged="OnPageChosen" />
        <ListView x:Name="FooterList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Footer}" SelectionMode="Single" IsItemClickEnabled="False"
                  ItemContainerStyle="{StaticResource LamhaNavItemStyle}" ItemTemplate="{StaticResource NavItemTemplate}"
                  AutomationProperties.Name="{x:Bind Settings}" SelectionChanged="OnPageChosen" />
      </Grid>

      <!-- The page, on Windows' content layer over Mica -->
      <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
        <Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <!-- The page fills the layer up to 760 px (the design's), from the start side -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="760" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Padding="32,28,32,40" Spacing="16">
                <TextBlock Margin="0,0,0,8" Style="{StaticResource LamhaPageTitleTextStyle}" Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                           AutomationProperties.HeadingLevel="Level1" />
                <ContentPresenter x:Name="PageHost" HorizontalContentAlignment="Stretch" />
              </StackPanel>
            </Grid>
          </ScrollViewer>

          <!-- "Copied", "History cleared · Undo": a moment at the foot of the page (Lamha 2's flash) -->
          <Border Margin="0,0,0,16" Padding="14,6" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                  controls:Pill.IsPill="True" Background="{ThemeResource LamhaToastBackgroundBrush}"
                  Visibility="{x:Bind controls:Show.IfText(ViewModel.Toast), Mode=OneWay, FallbackValue=Collapsed}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource LamhaToastTextBrush}"
                         Text="{x:Bind ViewModel.Toast, Mode=OneWay}" AutomationProperties.LiveSetting="Polite" />
              <HyperlinkButton Style="{StaticResource LamhaLinkButtonStyle}" Command="{x:Bind ViewModel.RunToastActionCommand}"
                               Visibility="{x:Bind controls:Show.IfText(ViewModel.ToastAction), Mode=OneWay, FallbackValue=Collapsed}">
                <TextBlock FontWeight="Bold" Foreground="{ThemeResource LamhaToastActionBrush}" Text="{x:Bind ViewModel.ToastAction, Mode=OneWay}" />
              </HyperlinkButton>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
