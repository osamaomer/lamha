<Window
    x:Class="Lamha.App.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Lamha.App.Controls"
    xmlns:search="using:Lamha.Core.Search">
  <!-- The main window, as Windows' Settings (docs/design/system.md, The window; decision 0020): Mica, Windows' title bar
       with Back (and ☰ when narrow), Windows' navigation pane with Lamha's header and coloured icons, and the page on
       Windows' content layer, which NavigationView draws. Two widths only, as Settings: the pane open, or hidden behind ☰. -->
  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBackKey" />
    </Grid.KeyboardAccelerators>

    <!-- Lamha's page colour instead of Mica (Settings → Appearance → the wallpaper behind the window) -->
    <Border x:Name="Solid" Grid.RowSpan="2" Background="{ThemeResource LamhaPageBrush}" Visibility="Collapsed" />

    <!-- Windows' title bar, as Settings': Back, ☰ when the pane is hidden, Lamha's name (its icon is the pane's header)
         and, narrow, 🔍 right after it; the search in the middle; Windows' buttons at its end -->
    <TitleBar x:Name="AppTitleBar" IsBackButtonVisible="True" IsBackButtonEnabled="False"
              IsPaneToggleButtonVisible="False" BackRequested="OnBackRequested" PaneToggleRequested="OnPaneToggleRequested">
      <!-- The middle is the search's slot; the code centres the box in the window, as Settings' -->
      <TitleBar.Resources>
        <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
      </TitleBar.Resources>
      <TitleBar.LeftHeader>
        <StackPanel x:Name="TitleName" Margin="{StaticResource LamhaTitleBarNameMargin}" Orientation="Horizontal" Spacing="{StaticResource LamhaSpace2}" VerticalAlignment="Center">
          <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Lamha}" />
          <Button x:Name="SearchButton" Style="{StaticResource LamhaTitleBarButtonStyle}" Visibility="Collapsed" Click="OnSearchButton"
                  ToolTipService.ToolTip="{x:Bind SearchPlaceholder}" AutomationProperties.Name="{x:Bind SearchPlaceholder}">
            <controls:FluentIcon Glyph="Search" />
          </Button>
        </StackPanel>
      </TitleBar.LeftHeader>
      <!-- The search, as Settings' "Find a setting": settings, words, copies, and "Translate …" (Core's QuickSearch).
           Narrow, it's the 🔍 button after the name, which opens the box. -->
      <Grid x:Name="SearchSlot" SizeChanged="OnSearchSlotChanged">
        <Grid x:Name="SearchArea" VerticalAlignment="Center">
          <AutoSuggestBox x:Name="Search" Style="{StaticResource LamhaTitleSearchStyle}"
                          PlaceholderText="{x:Bind SearchPlaceholder}" AutomationProperties.Name="{x:Bind SearchPlaceholder}"
                          TextChanged="OnSearchChanged" SuggestionChosen="OnSearchChosen" QuerySubmitted="OnSearchSubmitted" LostFocus="OnSearchLostFocus">
            <AutoSuggestBox.ItemTemplate>
              <DataTemplate x:DataType="search:QuickHit">
                <Grid ColumnSpacing="{StaticResource LamhaSpace3}" Padding="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <controls:FluentIcon Glyph="{x:Bind controls:Show.QuickGlyph(Kind)}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{x:Bind controls:Show.QuickText(Kind, Text)}" TextTrimming="CharacterEllipsis" TextReadingOrder="DetectFromContent" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                               TextReadingOrder="DetectFromContent" Text="{x:Bind controls:Show.QuickDetail(Kind, Detail)}"
                               Visibility="{x:Bind controls:Show.IfQuickDetail(Kind, Detail)}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </AutoSuggestBox.ItemTemplate>
          </AutoSuggestBox>
          <controls:FluentIcon Glyph="Search" Style="{StaticResource LamhaTitleSearchGlyphStyle}" />
        </Grid>
      </Grid>
    </TitleBar>

    <!-- Windows' navigation: open at 300, hidden behind ☰ below LamhaPaneHideWidth; Back and ☰ live in the title bar -->
    <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Auto" OpenPaneLength="{StaticResource LamhaPaneWidth}"
                    CompactModeThresholdWidth="{StaticResource LamhaPaneHideWidth}" ExpandedModeThresholdWidth="{StaticResource LamhaPaneHideWidth}"
                    IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" IsSettingsVisible="False" IsTitleBarAutoPaddingEnabled="False"
                    SelectionChanged="OnNavChanged" DisplayModeChanged="OnDisplayModeChanged">
      <!-- Lamha's icon, name and version where Settings has the account; it opens Settings → Lamha -->
      <NavigationView.PaneCustomContent>
        <Button Style="{StaticResource LamhaPaneHeaderStyle}" Click="OnHeaderClick" AutomationProperties.Name="{x:Bind Lamha}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource LamhaPaneHeaderGap}">
            <controls:AppIcon Size="{StaticResource LamhaPaneHeaderIconSize}" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Lamha}" />
              <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Version}" />
            </StackPanel>
          </StackPanel>
        </Button>
      </NavigationView.PaneCustomContent>
      <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
          <!-- The page, 28 from each side (Settings' padding) and up to 1000 wide -->
          <StackPanel x:Name="PageFrame" MaxWidth="{StaticResource LamhaPageMaxWidth}" HorizontalAlignment="Stretch" Padding="{StaticResource LamhaPageMargin}"
                      Spacing="{StaticResource LamhaSpace4}">
            <TextBlock Style="{StaticResource LamhaPageTitleTextStyle}" Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                       AutomationProperties.HeadingLevel="Level1" Visibility="{x:Bind ViewModel.ShowsTitle, Mode=OneWay}" />
            <ContentPresenter x:Name="PageHost" HorizontalContentAlignment="Stretch" />
          </StackPanel>
        </ScrollViewer>

        <!-- "Copied", "History cleared · Undo": a moment at the foot of the page (Lamha 2's flash) -->
        <Border x:Name="ToastBox" Margin="{StaticResource LamhaToastMargin}" Style="{StaticResource LamhaToastStyle}" Visibility="Collapsed"
                controls:Reveal.Shown="{x:Bind ViewModel.IsToastShown, Mode=OneWay}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource LamhaSpace3}">
            <TextBlock Style="{StaticResource LamhaToastTextStyle}" Text="{x:Bind ViewModel.Toast, Mode=OneWay}" AutomationProperties.LiveSetting="Polite" />
            <HyperlinkButton Style="{StaticResource LamhaLinkButtonStyle}" Command="{x:Bind ViewModel.RunToastActionCommand}" Content="{x:Bind ViewModel.ToastAction, Mode=OneWay}"
                             Visibility="{x:Bind controls:Show.IfText(ViewModel.ToastAction), Mode=OneWay, FallbackValue=Collapsed}" />
          </StackPanel>
        </Border>

        <!-- The day's goal reached: Lamha 2's burst of letters from the toast, over the page (left to right: the code places it) -->
        <Canvas x:Name="BurstLayer" FlowDirection="LeftToRight" IsHitTestVisible="False" />
      </Grid>
    </NavigationView>
  </Grid>
</Window>
