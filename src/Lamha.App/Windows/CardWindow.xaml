<Window
    x:Class="Lamha.App.Windows.CardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid x:Name="Root"
        Padding="{StaticResource LamhaCardPadding}"
        RowSpacing="{StaticResource LamhaSpace3}"
        KeyboardAcceleratorPlacementMode="Hidden">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
    </Grid.KeyboardAccelerators>

    <!-- The kind of text, and Close -->
    <Grid ColumnSpacing="{StaticResource LamhaSpace2}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center"
                 Style="{StaticResource CaptionTextBlockStyle}"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 Text="{x:Bind ViewModel.Kind, Mode=OneWay}" />
      <Button x:Uid="Card_Close"
              Grid.Column="1"
              Width="32" Height="32" Padding="0"
              CornerRadius="{StaticResource LamhaRadiusSmall}"
              Background="Transparent" BorderThickness="0"
              Command="{x:Bind ViewModel.CloseCommand}">
        <FontIcon FontSize="12" Glyph="&#xE711;" />
      </Button>
    </Grid>

    <!-- What was selected, and what Replace puts back -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="{StaticResource LamhaSpace3}">
        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                   Text="{x:Bind ViewModel.Text, Mode=OneWay}"
                   TextWrapping="Wrap"
                   IsTextSelectionEnabled="True" />
        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind ResultLabel}" />
        <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                   Text="{x:Bind ViewModel.Result, Mode=OneWay}"
                   TextWrapping="Wrap"
                   IsTextSelectionEnabled="True" />
      </StackPanel>
    </ScrollViewer>

    <!-- Actions -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="{StaticResource LamhaSpace2}">
      <Button x:Uid="Card_Replace"
              Style="{StaticResource AccentButtonStyle}"
              CornerRadius="{StaticResource LamhaRadiusSmall}"
              Command="{x:Bind ViewModel.ReplaceCommand}" />
      <Button x:Uid="Card_Copy"
              CornerRadius="{StaticResource LamhaRadiusSmall}"
              Command="{x:Bind ViewModel.CopyCommand}" />
    </StackPanel>
  </Grid>
</Window>
