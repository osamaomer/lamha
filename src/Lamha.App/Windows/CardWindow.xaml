<Window
    x:Class="Lamha.App.Windows.CardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid x:Name="Root"
        Padding="{StaticResource LamhaCardPadding}"
        RowSpacing="{StaticResource LamhaSpace3}"
        KeyboardAcceleratorPlacementMode="Hidden">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
    </Grid.KeyboardAccelerators>

    <!-- The kind of text, and Close -->
    <Grid ColumnSpacing="{StaticResource LamhaSpace2}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center"
                 Style="{StaticResource CaptionTextBlockStyle}"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 Text="{x:Bind ViewModel.Kind, Mode=OneWay}" />
      <Button x:Uid="Card_Close"
              Grid.Column="1"
              Width="32" Height="32" Padding="0"
              CornerRadius="{StaticResource LamhaRadiusSmall}"
              Background="Transparent" BorderThickness="0"
              Command="{x:Bind ViewModel.CloseCommand}">
        <FontIcon FontSize="12" Glyph="&#xE711;" />
      </Button>
    </Grid>

    <!-- What was selected, the lookup's answer (or the text to write), and what Replace / Insert puts back -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="{StaticResource LamhaSpace3}">
        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                   Text="{x:Bind ViewModel.Text, Mode=OneWay}"
                   TextWrapping="Wrap"
                   IsTextSelectionEnabled="True" />
        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind ResultLabel}" />
        <TextBox x:Name="ResultBox"
                 Text="{x:Bind ViewModel.Result, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 MaxHeight="120"
                 AutomationProperties.Name="{x:Bind ResultLabel}" />
        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource LamhaAccentBrush}"
                   Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </ScrollViewer>

    <!-- Actions -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="{StaticResource LamhaSpace2}">
      <Button Style="{StaticResource AccentButtonStyle}"
              CornerRadius="{StaticResource LamhaRadiusSmall}"
              Content="{x:Bind ViewModel.ReplaceLabel, Mode=OneWay}"
              Command="{x:Bind ViewModel.ReplaceCommand}">
        <!-- Lamha's button colour (or Windows' accent, made readable): Services/AccentService.cs. -->
        <Button.Resources>
          <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
              <ResourceDictionary x:Key="Default">
                <StaticResource x:Key="AccentButtonBackground" ResourceKey="LamhaButtonBrush" />
                <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="LamhaButtonBrush" />
                <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="LamhaButtonBrush" />
                <StaticResource x:Key="AccentButtonForeground" ResourceKey="LamhaButtonTextBrush" />
                <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="LamhaButtonTextBrush" />
                <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="LamhaButtonTextBrush" />
              </ResourceDictionary>
              <ResourceDictionary x:Key="Light">
                <StaticResource x:Key="AccentButtonBackground" ResourceKey="LamhaButtonBrush" />
                <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="LamhaButtonBrush" />
                <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="LamhaButtonBrush" />
                <StaticResource x:Key="AccentButtonForeground" ResourceKey="LamhaButtonTextBrush" />
                <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="LamhaButtonTextBrush" />
                <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="LamhaButtonTextBrush" />
              </ResourceDictionary>
              <!-- High contrast keeps the system's own button colours. -->
              <ResourceDictionary x:Key="HighContrast" />
            </ResourceDictionary.ThemeDictionaries>
          </ResourceDictionary>
        </Button.Resources>
      </Button>
      <Button x:Uid="Card_Copy"
              CornerRadius="{StaticResource LamhaRadiusSmall}"
              Command="{x:Bind ViewModel.CopyCommand}" />
    </StackPanel>
  </Grid>
</Window>
