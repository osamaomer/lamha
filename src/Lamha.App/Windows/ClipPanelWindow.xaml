<Window
    x:Class="Lamha.App.Windows.ClipPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Lamha.App.Controls"
    xmlns:card="using:Lamha.App.ViewModels.Card"
    xmlns:main="using:Lamha.App.ViewModels.Main">
  <!-- The clipboard quick panel, as signed off in phase 1 (docs/design/clipboard-panel.html): Lamha 2's 380 × 460 panel
       in the card's kind of window. The list (search, All / Pinned, the copies, the keys at the foot); Tab: the chosen
       copy's tools, numbered; a tool's result before it's pasted; the paused banner; and "not turned on yet". -->
  <Grid x:Name="Root" KeyboardAcceleratorPlacementMode="Hidden" PreviewKeyDown="OnPreviewKeyDown">
    <Grid.Resources>
      <!-- A key, as the foot and the copies' numbers draw it -->
      <Style x:Key="PanelKeyStyle" TargetType="Border">
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{ThemeResource LamhaChipBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LamhaLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="PanelKeyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LamhaTextStyle}">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="LineHeight" Value="15" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
      </Style>
      <Style x:Key="PanelFootTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LamhaTextStyle}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{ThemeResource LamhaTextMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
      </Style>
      <!-- A tool in the menu: the keyboard's choice is tinted (it has the focus; the mouse moves it), as Lamha 2's -->
      <Style x:Key="PanelToolStyle" TargetType="Button" BasedOn="{StaticResource LamhaRowButtonStyle}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
      </Style>
      <!-- A tool's result before it's pasted: 16.5 px bold (the design's) -->
      <Style x:Key="PanelResultTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LamhaTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeBodyLarge}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="26" />
      </Style>
    </Grid.Resources>

    <Border x:Name="SolidBackground" Background="{ThemeResource LamhaSurfaceBrush}" Visibility="Collapsed" />

    <!-- ===== Not turned on yet: what it keeps and where, and Turn on ===== -->
    <Grid Visibility="{x:Bind ViewModel.List.IsOff, Mode=OneWay}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Padding="16,12,16,0" Orientation="Horizontal" Spacing="8">
        <TextBlock Style="{StaticResource LamhaBodyTextStyle}" FontWeight="Bold" Text="{x:Bind Heading}" />
        <TextBlock VerticalAlignment="Bottom" Margin="0,0,0,1" Style="{StaticResource LamhaCaptionTextStyle}" Text="{x:Bind Hint}" />
      </StackPanel>
      <StackPanel Grid.Row="1" Padding="28,24" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
        <controls:FluentIcon Glyph="Clipboard" Size="Hero" Margin="0,0,0,4" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource LamhaTitleTextStyle}" Text="{x:Bind OptInTitle}" />
        <TextBlock MaxWidth="280" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource LamhaSecondaryTextStyle}" LineHeight="22"
                   Text="{x:Bind OptInText}" />
        <StackPanel Margin="0,8,0,0" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
          <Button x:Name="EnableButton" Style="{StaticResource LamhaButtonStyle}" Content="{x:Bind EnableLabel}" Command="{x:Bind ViewModel.List.TurnOnCommand}" />
          <Button Style="{StaticResource LamhaQuietButtonStyle}" Content="{x:Bind CancelLabel}" Command="{x:Bind ViewModel.CloseCommand}" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- ===== The list ===== -->
    <Grid Visibility="{x:Bind controls:Show.IfBoth(ViewModel.List.IsOn, ViewModel.IsList), Mode=OneWay}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Padding="16,12,16,0" Orientation="Horizontal" Spacing="8">
        <TextBlock Style="{StaticResource LamhaBodyTextStyle}" FontWeight="Bold" Text="{x:Bind Heading}" />
        <TextBlock VerticalAlignment="Bottom" Margin="0,0,0,1" Style="{StaticResource LamhaCaptionTextStyle}" Text="{x:Bind Hint}" />
      </StackPanel>

      <!-- Paused: Windows' InfoBar, and Resume -->
      <InfoBar Grid.Row="1" Margin="16,10,16,0" Visibility="Collapsed" controls:Reveal.Shown="{x:Bind ViewModel.List.IsPaused, Mode=OneWay}" controls:Reveal.Rise="-8" IsOpen="True" IsClosable="False" Severity="Warning"
               Title="{x:Bind PausedTitle}" Message="{x:Bind PausedText}">
        <InfoBar.ActionButton>
          <Button Style="{StaticResource LamhaQuietButtonStyle}" Content="{x:Bind ResumeLabel}" Command="{x:Bind ViewModel.List.ResumeCommand}" />
        </InfoBar.ActionButton>
      </InfoBar>

      <!-- Search, All / Pinned -->
      <Grid Grid.Row="2" Padding="16,10" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid>
          <Border Height="36" CornerRadius="{StaticResource LamhaRadiusControl}" BorderThickness="1" BorderBrush="{ThemeResource LamhaFieldLineBrush}"
                  Background="{ThemeResource LamhaSurfaceBrush}">
            <Grid>
              <TextBox x:Name="SearchBox" MinHeight="34" Padding="34,7,10,0" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                       FontFamily="{StaticResource LamhaFontFamily}" FontSize="{StaticResource LamhaFontSizeBody}" IsSpellCheckEnabled="False"
                       TextReadingOrder="DetectFromContent" TextAlignment="{x:Bind controls:Show.BoxAlignment(ViewModel.List.HasQuery), Mode=OneWay}"
                       PlaceholderText="{x:Bind SearchPlaceholder}" AutomationProperties.Name="{x:Bind SearchLabel}"
                       Text="{x:Bind ViewModel.List.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" GotFocus="OnSearchFocus" LostFocus="OnSearchFocus">
                <TextBox.Resources>
                  <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                  <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                  <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                  <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                  <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                  <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                  <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="Transparent" />
                  <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="Transparent" />
                </TextBox.Resources>
              </TextBox>
              <controls:FluentIcon Glyph="Search" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Foreground="{ThemeResource LamhaTextFaintBrush}" IsHitTestVisible="False" />
            </Grid>
          </Border>
          <Border x:Name="FieldRing" Margin="-2" CornerRadius="12" BorderThickness="2" BorderBrush="{ThemeResource LamhaAccentBrush}"
                  IsHitTestVisible="False" Visibility="Collapsed" />
        </Grid>
        <Border Grid.Column="1" Padding="2" VerticalAlignment="Center" controls:Pill.IsPill="True" Background="{ThemeResource LamhaChipBrush}">
          <StackPanel Orientation="Horizontal" AutomationProperties.Name="{x:Bind FilterLabel}">
            <ToggleButton Style="{StaticResource LamhaSwitchSegmentStyle}" MinHeight="28" Padding="10,4" FontSize="{StaticResource LamhaFontSizeCaption}" Content="{x:Bind AllLabel}" IsTabStop="False"
                          IsChecked="{x:Bind controls:Show.Not(ViewModel.List.PinnedOnly), Mode=OneWay}" Command="{x:Bind ViewModel.List.FilterCommand}" CommandParameter="false" />
            <ToggleButton Style="{StaticResource LamhaSwitchSegmentStyle}" MinHeight="28" Padding="10,4" FontSize="{StaticResource LamhaFontSizeCaption}" Content="{x:Bind PinnedLabel}" IsTabStop="False"
                          IsChecked="{x:Bind ViewModel.List.PinnedOnly, Mode=OneWay}" Command="{x:Bind ViewModel.List.FilterCommand}" CommandParameter="true" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- The copies: the chosen one tinted, with its pin and delete; a click pastes it -->
      <ScrollViewer x:Name="ListScroller" Grid.Row="3" Padding="8,0" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" IsTabStop="False">
        <StackPanel Padding="0,0,0,8">
          <ItemsRepeater x:Name="List" ItemsSource="{x:Bind ViewModel.List.Rows, Mode=OneWay}" AutomationProperties.Name="{x:Bind HistoryLabel}">
            <ItemsRepeater.Layout>
              <StackLayout Spacing="2" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="main:ClipRow">
                <Grid CornerRadius="{StaticResource LamhaRadiusControl}" Background="Transparent" Tapped="OnRowTapped" PointerMoved="OnRowPointerMoved"
                      AutomationProperties.Name="{x:Bind Text, Mode=OneWay}">
                  <Border CornerRadius="{StaticResource LamhaRadiusControl}" Background="{ThemeResource LamhaAccentSoftBrush}" Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                  <Grid Padding="8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                      <TextBlock Style="{StaticResource LamhaSecondaryTextStyle}" FontWeight="Bold" Foreground="{ThemeResource LamhaTextBrush}" TextWrapping="NoWrap"
                                 TextTrimming="CharacterEllipsis" FlowDirection="{x:Bind LabelFlow, Mode=OneWay}" Text="{x:Bind Label, Mode=OneWay}" controls:Marked.Query="{x:Bind Query, Mode=OneWay}"
                                 Visibility="{x:Bind controls:Show.IfText(Label), Mode=OneWay}" />
                      <TextBlock Style="{StaticResource LamhaSecondaryTextStyle}" Foreground="{ThemeResource LamhaTextBrush}" MaxLines="2" TextTrimming="CharacterEllipsis"
                                 FlowDirection="{x:Bind TextFlow, Mode=OneWay}" Text="{x:Bind Text, Mode=OneWay}" controls:Marked.Query="{x:Bind Query, Mode=OneWay}" />
                      <!-- An English copy's translation, once it's been translated -->
                      <TextBlock Style="{StaticResource LamhaSecondaryTextStyle}" FontSize="{StaticResource LamhaFontSizeCaption}" MaxLines="1" TextTrimming="CharacterEllipsis" FlowDirection="RightToLeft"
                                 Text="{x:Bind Translation, Mode=OneWay}" Visibility="{x:Bind controls:Show.IfText(Translation), Mode=OneWay}" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Style="{StaticResource PanelKeyStyle}" Padding="4,0" Visibility="{x:Bind controls:Show.IfText(Number), Mode=OneWay}">
                          <TextBlock Style="{StaticResource PanelKeyTextStyle}" Foreground="{ThemeResource LamhaTextMutedBrush}" Text="{x:Bind Number, Mode=OneWay}" />
                        </Border>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource LamhaCaptionTextStyle}" FontSize="{StaticResource LamhaFontSizeCaption}" Foreground="{ThemeResource LamhaTextFaintBrush}"
                                   TextWrapping="NoWrap" Text="{x:Bind Meta, Mode=OneWay}" />
                        <controls:FluentIcon Glyph="Pin" Size="Small" VerticalAlignment="Center" Foreground="{ThemeResource LamhaAccentBrush}"
                                           Visibility="{x:Bind Pinned, Mode=OneWay}" AutomationProperties.Name="{x:Bind PinnedName}" />
                      </StackPanel>
                    </StackPanel>
                    <!-- Pin and delete keep their room on every copy, so a copy's text doesn't reflow when it's chosen (Lamha 2's);
                         they act on the chosen copy, so only its own are there for the mouse and Narrator -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Orientation="Horizontal" Spacing="2" Opacity="{x:Bind controls:Show.Opaque(IsSelected), Mode=OneWay}"
                                IsHitTestVisible="{x:Bind IsSelected, Mode=OneWay}">
                      <ToggleButton Style="{StaticResource LamhaIconToggleStyle}" Width="28" Height="28" MinHeight="28" IsTabStop="False" IsChecked="{x:Bind Pinned, Mode=OneWay}"
                                    Command="{x:Bind Owner.TogglePinCommand}" ToolTipService.ToolTip="{x:Bind PinTooltip, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind PinTooltip, Mode=OneWay}" AutomationProperties.AccessibilityView="{x:Bind controls:Show.Reachable(IsSelected), Mode=OneWay}">
                        <controls:FluentIcon Glyph="Pin" Filled="{x:Bind Pinned, Mode=OneWay}" />
                      </ToggleButton>
                      <Button Style="{StaticResource LamhaIconButtonStyle}" IsTabStop="False" Command="{x:Bind Owner.DeleteCommand}"
                              ToolTipService.ToolTip="{x:Bind DeleteTooltip}" AutomationProperties.Name="{x:Bind DeleteTooltip}"
                              AutomationProperties.AccessibilityView="{x:Bind controls:Show.Reachable(IsSelected), Mode=OneWay}">
                        <controls:FluentIcon Glyph="Trash" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Grid>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
          <Button Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource LamhaQuietButtonStyle}" IsTabStop="False" Content="{x:Bind ShowMoreLabel}"
                  Command="{x:Bind ViewModel.List.ShowMoreCommand}" Visibility="{x:Bind ViewModel.List.HasMore, Mode=OneWay}" />
          <!-- Nothing yet, nothing pinned, no results -->
          <TextBlock Margin="16,24" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource LamhaSecondaryTextStyle}" Text="{x:Bind ViewModel.List.Empty, Mode=OneWay}"
                     Visibility="{x:Bind controls:Show.IfText(ViewModel.List.Empty), Mode=OneWay}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </ScrollViewer>

      <!-- The keys -->
      <Border Grid.Row="4" Padding="16,8" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource LamhaLineBrush}">
        <controls:WrapPanel HorizontalSpacing="14" VerticalSpacing="4">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Border Style="{StaticResource PanelKeyStyle}"><TextBlock Style="{StaticResource PanelKeyTextStyle}" Text="Enter" /></Border>
            <TextBlock Style="{StaticResource PanelFootTextStyle}" Text="{x:Bind KeyPaste}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <StackPanel FlowDirection="LeftToRight" Orientation="Horizontal" Spacing="1">
              <Border Style="{StaticResource PanelKeyStyle}"><TextBlock Style="{StaticResource PanelKeyTextStyle}" Text="Shift" /></Border>
              <TextBlock Style="{StaticResource PanelFootTextStyle}" Text="+" />
              <Border Style="{StaticResource PanelKeyStyle}"><TextBlock Style="{StaticResource PanelKeyTextStyle}" Text="Enter" /></Border>
            </StackPanel>
            <TextBlock Style="{StaticResource PanelFootTextStyle}" Text="{x:Bind KeyPlain}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Border Style="{StaticResource PanelKeyStyle}"><TextBlock Style="{StaticResource PanelKeyTextStyle}" Text="Tab" /></Border>
            <TextBlock Style="{StaticResource PanelFootTextStyle}" Text="{x:Bind KeyTools}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Border Style="{StaticResource PanelKeyStyle}"><TextBlock Style="{StaticResource PanelKeyTextStyle}" Text="Esc" /></Border>
            <TextBlock Style="{StaticResource PanelFootTextStyle}" Text="{x:Bind KeyClose}" />
          </StackPanel>
        </controls:WrapPanel>
      </Border>
    </Grid>

    <!-- ===== Tab: the chosen copy's tools, then a tool's result ===== -->
    <Grid Visibility="{x:Bind ViewModel.IsTools, Mode=OneWay}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Padding="12,10,12,0" Orientation="Horizontal" Spacing="4">
        <Button Style="{StaticResource LamhaIconButtonStyle}" IsTabStop="False" Command="{x:Bind ViewModel.BackToListCommand}"
                ToolTipService.ToolTip="{x:Bind BackToList}" AutomationProperties.Name="{x:Bind BackToList}">
          <controls:FluentIcon Glyph="Back" />
        </Button>
        <TextBlock VerticalAlignment="Center" Style="{StaticResource LamhaBodyTextStyle}" FontWeight="Bold" Text="{x:Bind ToolsTitle}" />
      </StackPanel>

      <!-- The copy -->
      <Border Grid.Row="1" Margin="16,8" Padding="12,10" CornerRadius="{StaticResource LamhaRadiusControl}" Background="{ThemeResource LamhaChipBrush}">
        <StackPanel Spacing="2">
          <TextBlock Style="{StaticResource LamhaBodyTextStyle}" FontWeight="SemiBold" MaxLines="2" TextTrimming="CharacterEllipsis"
                     FlowDirection="{x:Bind ViewModel.ToolsTextFlow, Mode=OneWay}" Text="{x:Bind ViewModel.ToolsText, Mode=OneWay}" />
          <TextBlock Style="{StaticResource LamhaCaptionTextStyle}" FontSize="{StaticResource LamhaFontSizeCaption}" Foreground="{ThemeResource LamhaTextFaintBrush}" TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis" Text="{x:Bind ViewModel.ToolsMeta, Mode=OneWay}" />
        </StackPanel>
      </Border>

      <!-- The tools that fit the copy, numbered -->
      <ScrollViewer Grid.Row="2" Padding="8,0" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" IsTabStop="False"
                    Visibility="{x:Bind ViewModel.ToolsRow.IsIdle, Mode=OneWay, FallbackValue=Collapsed}">
        <ItemsRepeater x:Name="ToolList" ItemsSource="{x:Bind ViewModel.ToolsRow.Tools, Mode=OneWay}" AutomationProperties.Name="{x:Bind ToolsLabel}">
          <ItemsRepeater.Layout>
            <StackLayout Spacing="2" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="main:ClipTool">
              <Button Style="{StaticResource PanelToolStyle}" Command="{x:Bind Run}" AutomationProperties.Name="{x:Bind Label}" AutomationProperties.HelpText="{x:Bind Hint}"
                      GotFocus="OnToolFocus" LostFocus="OnToolFocus" PointerEntered="OnToolPointerEntered">
                <Grid ColumnSpacing="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center" TextAlignment="Center" Style="{StaticResource LamhaLabelTextStyle}" FontWeight="Bold"
                             Foreground="{ThemeResource LamhaTextMutedBrush}" Text="{x:Bind Number}" />
                  <Border Grid.Column="1" Width="28" Height="28" CornerRadius="{StaticResource LamhaRadiusControl}" Background="{ThemeResource LamhaChipBrush}">
                    <controls:FluentIcon Glyph="{x:Bind Glyph}" Foreground="{ThemeResource LamhaAccentBrush}" />
                  </Border>
                  <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource LamhaBodyTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                             Text="{x:Bind Label}" />
                  <TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource LamhaCaptionTextStyle}" TextWrapping="NoWrap" Text="{x:Bind Hint}" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </ScrollViewer>

      <!-- A tool's answer, in the tools' place -->
      <ScrollViewer Grid.Row="2" Padding="16,0" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" IsTabStop="False"
                    Visibility="{x:Bind controls:Show.IfNot(ViewModel.ToolsRow.IsIdle), Mode=OneWay, FallbackValue=Collapsed}">
        <StackPanel Padding="0,0,0,12" Spacing="8">
          <!-- Working -->
          <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ToolsRow.IsWorking, Mode=OneWay, FallbackValue=Collapsed}">
            <controls:Skeleton Height="14" Margin="0,0,24,0" CornerRadius="{StaticResource LamhaRadiusControl}" />
            <controls:Skeleton Height="14" Margin="0,0,120,0" CornerRadius="{StaticResource LamhaRadiusControl}" />
          </StackPanel>

          <!-- A result: the summary's language, the text (Proofread's corrections struck through), Paste, Copy and Redo -->
          <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ToolsRow.IsResult, Mode=OneWay, FallbackValue=Collapsed}">
            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.ToolsRow.IsSummary, Mode=OneWay, FallbackValue=Collapsed}"
                        AutomationProperties.Name="{x:Bind SummaryLangName}">
              <TextBlock VerticalAlignment="Center" Style="{StaticResource LamhaCaptionTextStyle}" Text="{x:Bind SummaryLangColon}" />
              <Border Padding="2" controls:Pill.IsPill="True" Background="{ThemeResource LamhaChipBrush}">
                <StackPanel Orientation="Horizontal">
                  <ToggleButton Style="{StaticResource LamhaSwitchSegmentStyle}" Content="العربية"
                                IsChecked="{x:Bind controls:Show.Not(ViewModel.ToolsRow.SummaryInEnglish), Mode=OneWay, FallbackValue=False}"
                                Command="{x:Bind ViewModel.List.SummaryInCommand}" CommandParameter="ar" />
                  <ToggleButton Style="{StaticResource LamhaSwitchSegmentStyle}" Content="English" IsChecked="{x:Bind ViewModel.ToolsRow.SummaryInEnglish, Mode=OneWay, FallbackValue=False}"
                                Command="{x:Bind ViewModel.List.SummaryInCommand}" CommandParameter="en" />
                </StackPanel>
              </Border>
            </StackPanel>
            <Border Padding="16,12" CornerRadius="{StaticResource LamhaRadiusControl}" Background="{ThemeResource LamhaAccentSoftBrush}">
              <controls:DiffText FlowDirection="{x:Bind ViewModel.ToolsRow.ResultFlow, Mode=OneWay, FallbackValue=LeftToRight}" TextStyle="{StaticResource PanelResultTextStyle}"
                                 Parts="{x:Bind ViewModel.ToolsRow.Diff, Mode=OneWay}" Fallback="{x:Bind ViewModel.ToolsRow.Result, Mode=OneWay, FallbackValue=''}" />
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button x:Name="PasteButton" Style="{StaticResource LamhaButtonStyle}" Command="{x:Bind ViewModel.PasteResultCommand}" AutomationProperties.Name="{x:Bind PasteLabel}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <controls:FluentIcon Glyph="Check" />
                  <TextBlock Text="{x:Bind PasteLabel}" />
                  <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="{StaticResource LamhaFontSizeCaption}" FontWeight="Medium" Opacity="0.75" Text="Enter" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource LamhaQuietButtonStyle}" Command="{x:Bind ViewModel.List.CopyResultCommand}" AutomationProperties.Name="{x:Bind CopyLabel}" controls:Feedback.Copy="True">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <controls:FluentIcon Glyph="Copy" />
                  <TextBlock Text="{x:Bind CopyLabel}" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource LamhaQuietButtonStyle}" Command="{x:Bind ViewModel.List.RedoCommand}" ToolTipService.ToolTip="{x:Bind NewResult}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <controls:FluentIcon Glyph="Retry" />
                  <TextBlock Text="{x:Bind RedoLabel}" />
                </StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Style="{StaticResource LamhaCaptionTextStyle}" Text="{x:Bind CachedNote}" Visibility="{x:Bind ViewModel.ToolsRow.Cached, Mode=OneWay, FallbackValue=Collapsed}" />

            <!-- Proofreading: each correction, its kind, and why -->
            <StackPanel Visibility="{x:Bind ViewModel.ToolsRow.IsProofread, Mode=OneWay, FallbackValue=Collapsed}">
              <Grid Style="{StaticResource LamhaSectionRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource LamhaSectionHeadingTextStyle}" Text="{x:Bind ViewModel.ToolsRow.CorrectionsTitle, Mode=OneWay, FallbackValue=''}" />
                <Border Grid.Column="1" Height="1" VerticalAlignment="Center" Background="{ThemeResource LamhaLineBrush}" />
              </Grid>
              <ItemsControl ItemsSource="{x:Bind ViewModel.ToolsRow.Issues, Mode=OneWay}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="card:IssueItem">
                    <StackPanel Padding="0,8" BorderBrush="{ThemeResource LamhaLineBrush}" BorderThickness="0,0,0,1">
                      <TextBlock Style="{StaticResource LamhaBodyTextStyle}" FlowDirection="LeftToRight" TextAlignment="{x:Bind controls:Show.LatinAlignment}">
                        <Run Text="{x:Bind Original}" Foreground="{ThemeResource LamhaDangerBrush}" TextDecorations="Strikethrough" /><Run Text=" → " /><Run Text="{x:Bind Fix}" Foreground="{ThemeResource LamhaOkBrush}" FontWeight="SemiBold" />
                      </TextBlock>
                      <Border Margin="0,4,0,0" Padding="8,1" HorizontalAlignment="Left" controls:Pill.IsPill="True"
                              Background="{ThemeResource LamhaAccentSoftBrush}" Visibility="{x:Bind HasCategory, FallbackValue=Collapsed}">
                        <TextBlock Style="{StaticResource LamhaLabelTextStyle}" Foreground="{ThemeResource LamhaAccentBrush}" Text="{x:Bind Category}" />
                      </Border>
                      <TextBlock Margin="0,2,0,0" Style="{StaticResource LamhaSecondaryTextStyle}" FlowDirection="{x:Bind WhyFlow}" Text="{x:Bind Why}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>

          <!-- No mistakes, and Redo -->
          <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ToolsRow.IsNoMistakes, Mode=OneWay, FallbackValue=Collapsed}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <controls:FluentIcon Glyph="Check" Foreground="{ThemeResource LamhaOkBrush}" />
              <TextBlock Style="{StaticResource LamhaBodyTextStyle}" FontWeight="SemiBold" Foreground="{ThemeResource LamhaOkBrush}" Text="{x:Bind NoMistakes}" />
            </StackPanel>
            <Button x:Name="NoMistakesRedo" HorizontalAlignment="Left" Style="{StaticResource LamhaQuietButtonStyle}" Command="{x:Bind ViewModel.List.RedoCommand}"
                    ToolTipService.ToolTip="{x:Bind NewResult}" Content="{x:Bind RedoLabel}" />
          </StackPanel>

          <!-- Added to review, or removed: the word's meaning under it -->
          <StackPanel Spacing="2" Visibility="{x:Bind ViewModel.ToolsRow.IsDone, Mode=OneWay, FallbackValue=Collapsed}">
            <TextBlock Style="{StaticResource LamhaBodyTextStyle}" FontWeight="SemiBold" Foreground="{ThemeResource LamhaOkBrush}" Text="{x:Bind ViewModel.ToolsRow.DoneText, Mode=OneWay, FallbackValue=''}" />
            <TextBlock Style="{StaticResource LamhaSecondaryTextStyle}" TextReadingOrder="DetectFromContent" Text="{x:Bind ViewModel.ToolsRow.DoneMeaning, Mode=OneWay, FallbackValue=''}" />
          </StackPanel>

          <!-- An error: what happened, what to do, Try again or Settings -->
          <StackPanel Spacing="2" Visibility="{x:Bind ViewModel.ToolsRow.IsError, Mode=OneWay, FallbackValue=Collapsed}">
            <TextBlock Style="{StaticResource LamhaTitleTextStyle}" Text="{x:Bind ViewModel.ToolsRow.Error.Title, Mode=OneWay, FallbackValue=''}" />
            <TextBlock Style="{StaticResource LamhaSecondaryTextStyle}" Text="{x:Bind ViewModel.ToolsRow.Error.Hint, Mode=OneWay, FallbackValue=''}" />
            <Button x:Name="ErrorButton" Margin="0,6,0,0" HorizontalAlignment="Left" Style="{StaticResource LamhaQuietButtonStyle}" Command="{x:Bind ViewModel.List.RunErrorActionCommand}"
                    Visibility="{x:Bind controls:Show.ErrorButton(ViewModel.ToolsRow.Error), Mode=OneWay, FallbackValue=Collapsed}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <controls:FluentIcon Glyph="Retry" />
                <TextBlock Text="{x:Bind controls:Show.ErrorLabel(ViewModel.ToolsRow.Error), Mode=OneWay, FallbackValue=''}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- The keys: the tools' (Enter, 1–n, Esc), or a result's (Enter pastes, Esc back to the tools) -->
      <Border Grid.Row="3" Padding="16,8" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource LamhaLineBrush}">
        <Grid>
          <controls:WrapPanel HorizontalSpacing="14" VerticalSpacing="4" Visibility="{x:Bind ViewModel.ToolsRow.IsIdle, Mode=OneWay, FallbackValue=Collapsed}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Border Style="{StaticResource PanelKeyStyle}"><TextBlock Style="{StaticResource PanelKeyTextStyle}" Text="Enter" /></Border>
              <TextBlock Style="{StaticResource PanelFootTextStyle}" Text="{x:Bind KeyRun}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Border Style="{StaticResource PanelKeyStyle}"><TextBlock Style="{StaticResource PanelKeyTextStyle}" Text="{x:Bind ViewModel.ToolsRange, Mode=OneWay}" /></Border>
              <TextBlock Style="{StaticResource PanelFootTextStyle}" Text="{x:Bind KeyShortcut}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Border Style="{StaticResource PanelKeyStyle}"><TextBlock Style="{StaticResource PanelKeyTextStyle}" Text="Esc" /></Border>
              <TextBlock Style="{StaticResource PanelFootTextStyle}" Text="{x:Bind KeyBack}" />
            </StackPanel>
          </controls:WrapPanel>
          <controls:WrapPanel HorizontalSpacing="14" VerticalSpacing="4" Visibility="{x:Bind controls:Show.IfNot(ViewModel.ToolsRow.IsIdle), Mode=OneWay, FallbackValue=Collapsed}">
            <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind ViewModel.ToolsRow.IsResult, Mode=OneWay, FallbackValue=Collapsed}">
              <Border Style="{StaticResource PanelKeyStyle}"><TextBlock Style="{StaticResource PanelKeyTextStyle}" Text="Enter" /></Border>
              <TextBlock Style="{StaticResource PanelFootTextStyle}" Text="{x:Bind KeyPaste}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Border Style="{StaticResource PanelKeyStyle}"><TextBlock Style="{StaticResource PanelKeyTextStyle}" Text="Esc" /></Border>
              <TextBlock Style="{StaticResource PanelFootTextStyle}" Text="{x:Bind KeyToolsBack}" />
            </StackPanel>
          </controls:WrapPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- "Pinned", "Deleted · Undo": a moment above the foot (Lamha 2's lc-toast) -->
    <Border Margin="0,0,0,44" Style="{StaticResource LamhaToastStyle}" Visibility="Collapsed"
            controls:Reveal.Shown="{x:Bind ViewModel.IsToastShown, Mode=OneWay}">
      <StackPanel Orientation="Horizontal" Spacing="{StaticResource LamhaSpace3}">
        <TextBlock Style="{StaticResource LamhaToastTextStyle}" Text="{x:Bind ViewModel.Toast, Mode=OneWay}" AutomationProperties.LiveSetting="Polite" />
        <HyperlinkButton Style="{StaticResource LamhaLinkButtonStyle}" IsTabStop="False" Command="{x:Bind ViewModel.RunToastActionCommand}" Content="{x:Bind ViewModel.ToastAction, Mode=OneWay}"
                         Visibility="{x:Bind controls:Show.IfText(ViewModel.ToastAction), Mode=OneWay, FallbackValue=Collapsed}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
