<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Lamha.App.Controls">
  <!-- Lamha's base controls, from the tokens (merged here so the styles can name them) and phase 1's signed-off
       designs: buttons (filled, quiet, delete, icon), chips, the switch in Lamha 2's green, and the boxes the screens
       repeat. tests/Lamha.Core.Tests/Appearance/TokensTests.cs checks that every Lamha resource named exists. -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="ms-appx:///Themes/Tokens.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- The switch, as Windows': on in the accent fill (LamhaButtonBrush's colour; AccentService repaints these with it)
       and the knob in the button's text colour; high contrast keeps Windows' own. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#4F46E5" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#4F46E5" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#4F46E5" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#9AA1FF" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#9AA1FF" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#9AA1FF" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#0B0B12" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#0B0B12" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#0B0B12" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast" />
  </ResourceDictionary.ThemeDictionaries>

  <!-- Lamha's mark: its gradient, which follows the theme (Windows' highlight in high contrast) -->
  <Style TargetType="controls:BrandMark">
    <Setter Property="Background" Value="{ThemeResource LamhaBrandBrush}" />
  </Style>

  <!-- Buttons: one template, coloured by the style. A hover tint over the fill, a little faded when pressed,
       Lamha 2's 0.45 when it can't be used; Windows draws the focus ring. -->
  <ControlTemplate x:Key="LamhaButtonTemplate" TargetType="Button">
    <Grid x:Name="Root"
          Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}"
          CornerRadius="{TemplateBinding CornerRadius}"
          Control.IsTemplateFocusTarget="True">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Target="Hover.Opacity" Value="1" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters>
              <Setter Target="Hover.Opacity" Value="1" />
              <Setter Target="Presenter.Opacity" Value="0.8" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Target="Root.Opacity" Value="0.45" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Border x:Name="Hover" Background="{ThemeResource LamhaHoverBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
      <ContentPresenter x:Name="Presenter"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        ContentTransitions="{TemplateBinding ContentTransitions}"
                        FontFamily="{TemplateBinding FontFamily}"
                        FontSize="{TemplateBinding FontSize}"
                        FontWeight="{TemplateBinding FontWeight}"
                        Foreground="{TemplateBinding Foreground}"
                        AutomationProperties.AccessibilityView="Raw" />
    </Grid>
  </ControlTemplate>

  <!-- Filled: the one action that matters (Replace, Save & verify, Next). The card's sizes: 32 px high, 13 px
       semibold, the inputs' 10 px corners. -->
  <Style x:Key="LamhaButtonStyle" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource LamhaButtonTemplate}" />
    <Setter Property="Background" Value="{ThemeResource LamhaButtonBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource LamhaButtonTextBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource LamhaControlEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource LamhaRadiusControl}" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FontFamily" Value="{StaticResource LamhaFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
  </Style>

  <!-- Quiet: everything next to the filled one (Copy, Restore, Cancel) -->
  <Style x:Key="LamhaQuietButtonStyle" TargetType="Button" BasedOn="{StaticResource LamhaButtonStyle}">
    <Setter Property="Background" Value="{ThemeResource LamhaChipBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource LamhaTextBrush}" />
  </Style>

  <!-- Review's answers (Forgot / Hard / Knew it): the answer over when it brings the word back, filling its column;
       each sets its own tint and colour -->
  <Style x:Key="LamhaGradeButtonStyle" TargetType="Button" BasedOn="{StaticResource LamhaButtonStyle}">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeBody}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <!-- "Delete" in a question (Lamha 2's dialog.js danger choice): the one red in both themes, white text at 4.8:1 -->
  <Style x:Key="LamhaDialogDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource LamhaButtonStyle}">
    <Setter Property="Background" Value="{ThemeResource LamhaDangerSolidBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource LamhaDangerSolidTextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- Deletes something: never looks like a harmless action (Lamha 2's btn.danger) -->
  <Style x:Key="LamhaDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource LamhaButtonStyle}">
    <Setter Property="Background" Value="{ThemeResource LamhaDangerSoftBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource LamhaDangerBrush}" />
  </Style>

  <!-- An icon alone (the card's bar, Copy, Listen): 28 px, the name in its tooltip and AutomationProperties.Name -->
  <Style x:Key="LamhaIconButtonStyle" TargetType="Button" BasedOn="{StaticResource LamhaButtonStyle}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource LamhaTextMutedBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource LamhaRadiusControl}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="28" />
  </Style>

  <!-- A round button next to the headword (the review bookmark, Listen): 34 px (the card's design) -->
  <Style x:Key="LamhaRoundButtonStyle" TargetType="Button" BasedOn="{StaticResource LamhaIconButtonStyle}">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="controls:Pill.IsPill" Value="True" />
  </Style>

  <!-- Listen next to the headword: round, in the accent colour on its tint (the card's design) -->
  <Style x:Key="LamhaRoundSpeakButtonStyle" TargetType="Button" BasedOn="{StaticResource LamhaRoundButtonStyle}">
    <Setter Property="Background" Value="{ThemeResource LamhaAccentSoftBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource LamhaAccentBrush}" />
  </Style>

  <!-- A chip that does something once (a meaning or synonym to look up, "+3"): the chip's look on a button -->
  <Style x:Key="LamhaChipButtonStyle" TargetType="Button" BasedOn="{StaticResource LamhaButtonStyle}">
    <Setter Property="Background" Value="{ThemeResource LamhaChipBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource LamhaTextBrush}" />
    <Setter Property="controls:Pill.IsPill" Value="True" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="MinHeight" Value="{StaticResource LamhaMinTargetSize}" />
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeBody}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <!-- A link at the foot of the card (Google Translate, Better translation): an icon and a word, quiet until hovered -->
  <Style x:Key="LamhaFootLinkStyle" TargetType="Button" BasedOn="{StaticResource LamhaButtonStyle}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource LamhaTextMutedBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource LamhaRadiusControl}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinHeight" Value="{StaticResource LamhaMinTargetSize}" />
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeCaption}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <!-- An icon that stays on (Pin, the review bookmark): muted, and in the accent colour on its tint when on -->
  <Style x:Key="LamhaIconToggleStyle" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource LamhaTextMutedBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource LamhaControlEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource LamhaRadiusControl}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Control.IsTemplateFocusTarget="True">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Hover.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Hover.Opacity" Value="1" />
                    <Setter Target="Presenter.Opacity" Value="0.8" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.45" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource LamhaAccentSoftBrush}" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource LamhaAccentBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource LamhaAccentSoftBrush}" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource LamhaAccentBrush}" />
                    <Setter Target="Hover.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource LamhaAccentSoftBrush}" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource LamhaAccentBrush}" />
                    <Setter Target="Presenter.Opacity" Value="0.8" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedDisabled">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource LamhaAccentBrush}" />
                    <Setter Target="Root.Opacity" Value="0.45" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Hover" Background="{ThemeResource LamhaHoverBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
            <ContentPresenter x:Name="Presenter"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              AutomationProperties.AccessibilityView="Raw" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The review bookmark next to the headword: round, 34 px; in the accent colour when the word is in review -->
  <Style x:Key="LamhaRoundToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource LamhaIconToggleStyle}">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="controls:Pill.IsPill" Value="True" />
  </Style>

  <!-- A segment of a two-way switch in a pill (the card's العربية ⇄ English): the chosen one raised on the surface -->
  <Style x:Key="LamhaSwitchSegmentStyle" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource LamhaTextMutedBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="controls:Pill.IsPill" Value="True" />
    <Setter Property="Padding" Value="10,2" />
    <Setter Property="MinHeight" Value="{StaticResource LamhaMinTargetSize}" />
    <Setter Property="FontFamily" Value="{StaticResource LamhaFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Control.IsTemplateFocusTarget="True">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource LamhaTextBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Opacity" Value="0.8" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource LamhaSurfaceBrush}" />
                    <Setter Target="Root.BorderBrush" Value="{ThemeResource LamhaControlEdgeBrush}" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource LamhaTextBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource LamhaSurfaceBrush}" />
                    <Setter Target="Root.BorderBrush" Value="{ThemeResource LamhaControlEdgeBrush}" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource LamhaTextBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource LamhaSurfaceBrush}" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource LamhaTextBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter x:Name="Presenter"
                              Padding="{TemplateBinding Padding}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Content="{TemplateBinding Content}"
                              FontFamily="{TemplateBinding FontFamily}"
                              FontSize="{TemplateBinding FontSize}"
                              FontWeight="{TemplateBinding FontWeight}"
                              Foreground="{TemplateBinding Foreground}"
                              AutomationProperties.AccessibilityView="Raw" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Chips: a meaning, a synonym, a writing tool, a choice. On (checked) in the button colour. -->
  <Style x:Key="LamhaChipStyle" TargetType="ToggleButton">
    <Setter Property="Background" Value="{ThemeResource LamhaChipBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource LamhaTextBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource LamhaControlEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="controls:Pill.IsPill" Value="True" />
    <Setter Property="Padding" Value="10,2" />
    <Setter Property="MinHeight" Value="{StaticResource LamhaMinTargetSize}" />
    <Setter Property="FontFamily" Value="{StaticResource LamhaFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeBody}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Control.IsTemplateFocusTarget="True">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Hover.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Hover.Opacity" Value="1" />
                    <Setter Target="Presenter.Opacity" Value="0.8" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.45" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource LamhaButtonBrush}" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource LamhaButtonTextBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource LamhaButtonBrush}" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource LamhaButtonTextBrush}" />
                    <Setter Target="Hover.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource LamhaButtonBrush}" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource LamhaButtonTextBrush}" />
                    <Setter Target="Presenter.Opacity" Value="0.8" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedDisabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource LamhaButtonBrush}" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource LamhaButtonTextBrush}" />
                    <Setter Target="Root.Opacity" Value="0.45" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Hover" Background="{ThemeResource LamhaHoverBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
            <ContentPresenter x:Name="Presenter"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              FontFamily="{TemplateBinding FontFamily}"
                              FontSize="{TemplateBinding FontSize}"
                              FontWeight="{TemplateBinding FontWeight}"
                              Foreground="{TemplateBinding Foreground}"
                              AutomationProperties.AccessibilityView="Raw" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A skeleton: the grey shape of what's coming, with a light sweeping across it (Controls/Skeleton.cs moves it) -->
  <Style TargetType="controls:Skeleton">
    <Setter Property="Background" Value="{ThemeResource LamhaSkeletonBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource LamhaRadiusControl}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:Skeleton">
          <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
            <Rectangle x:Name="Shine" Visibility="Collapsed">
              <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Offset="0" Color="#00FFFFFF" />
                  <GradientStop Offset="0.5" Color="{ThemeResource LamhaShimmerColor}" />
                  <GradientStop Offset="1" Color="#00FFFFFF" />
                </LinearGradientBrush>
              </Rectangle.Fill>
              <Rectangle.RenderTransform>
                <TranslateTransform x:Name="Move" />
              </Rectangle.RenderTransform>
            </Rectangle>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Boxes the screens repeat: a panel (Today, the answer, a group of settings) and the tinted box the meaning
       sits in (the card's hero, the corrected text) -->
  <Style x:Key="LamhaPanelStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource LamhaSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource LamhaLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource LamhaRadiusOverlay}" />
    <Setter Property="Padding" Value="20" />
  </Style>
  <Style x:Key="LamhaTintedBoxStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource LamhaAccentSoftBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource LamhaRadiusControl}" />
    <Setter Property="Padding" Value="16,12" />
  </Style>

  <!-- A section's heading with the line after it ("Other meanings ———"): a Grid of the heading and a 1 px line -->
  <Style x:Key="LamhaSectionRowStyle" TargetType="Grid">
    <Setter Property="ColumnSpacing" Value="8" />
    <Setter Property="Margin" Value="0,20,0,8" />
  </Style>

  <!-- Chips in lines that wrap: meanings, synonyms, choices -->
  <ItemsPanelTemplate x:Key="LamhaWrapChipsPanel">
    <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="4" />
  </ItemsPanelTemplate>

  <!-- A row that does something (a recent lookup): the whole row is the button, tinted under the mouse. Its text is
       10 px in, the 1 px edge (seen in high contrast) included, so it lines up with the text around it. -->
  <Style x:Key="LamhaRowButtonStyle" TargetType="Button" BasedOn="{StaticResource LamhaButtonStyle}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource LamhaTextBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource LamhaRadiusControl}" />
    <Setter Property="Padding" Value="9,7" />
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeBody}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <!-- A link in a line of text (Clear, See its meaning): the accent colour, 12.5 px semibold (Lamha 2's .link) -->
  <Style x:Key="LamhaLinkButtonStyle" TargetType="HyperlinkButton">
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource LamhaFontFamily}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource LamhaAccentBrush}" />
  </Style>

  <!-- ===== Settings (phase 1's Settings design) ===== -->

  <!-- A settings card: the surface, its 1 px edge and 8 px corners, 68 px high (a short one sets 48); the text 16 px from
       the edge, the edge included. A card that holds more than one control is a Border in LamhaSettingsPanelStyle. -->
  <Style x:Key="LamhaSettingsPanelStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource LamhaSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource LamhaLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource LamhaRadiusControl}" />
    <Setter Property="Padding" Value="15,11" />
    <Setter Property="MinHeight" Value="68" />
  </Style>
  <Style TargetType="controls:SettingsCard">
    <Setter Property="Background" Value="{ThemeResource LamhaSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource LamhaLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource LamhaRadiusControl}" />
    <Setter Property="Padding" Value="15,11" />
    <Setter Property="MinHeight" Value="68" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:SettingsCard">
          <Grid Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}" ColumnSpacing="16"
                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Style="{StaticResource LamhaBodyTextStyle}" TextReadingOrder="UseFlowDirection" Text="{TemplateBinding Header}" />
              <TextBlock x:Name="Description" Style="{StaticResource LamhaCaptionTextStyle}" TextReadingOrder="UseFlowDirection" Text="{TemplateBinding Description}" />
            </StackPanel>
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Content="{TemplateBinding Content}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A category on Settings' home: the card's look on a button, tinted under the mouse -->
  <Style x:Key="LamhaTileButtonStyle" TargetType="Button" BasedOn="{StaticResource LamhaButtonStyle}">
    <Setter Property="Background" Value="{ThemeResource LamhaSurfaceBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource LamhaTextBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource LamhaLineBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource LamhaRadiusControl}" />
    <Setter Property="Padding" Value="15,11" />
    <Setter Property="MinHeight" Value="68" />
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeBody}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <!-- The breadcrumb's "Settings": the page title's size, muted until the mouse is over it -->
  <Style x:Key="LamhaCrumbButtonStyle" TargetType="HyperlinkButton">
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource LamhaFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource LamhaTextMutedBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="HyperlinkButton">
          <ContentPresenter x:Name="Presenter" Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                            FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                            Background="Transparent" Control.IsTemplateFocusTarget="True" AutomationProperties.AccessibilityView="Raw">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource LamhaTextBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource LamhaTextBrush}" />
                    <Setter Target="Presenter.Opacity" Value="0.8" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </ContentPresenter>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A choice among a few, with its hint (Translation, Without internet): the design's 20 px ring, filled to a 5 px
       ring in the button colour when chosen; 10 px above and below, so the lines between choices sit in the middle -->
  <Style x:Key="LamhaRadioStyle" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{ThemeResource LamhaTextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0,10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="-4,2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" ColumnSpacing="12">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Ring.Stroke" Value="{ThemeResource LamhaTextMutedBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Ring.Stroke" Value="{ThemeResource LamhaTextMutedBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.45" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Ring.Stroke" Value="{ThemeResource LamhaButtonBrush}" />
                    <Setter Target="Ring.StrokeThickness" Value="5" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="20" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="Ring" Width="20" Height="20" Margin="0,1,0,0" VerticalAlignment="Top" Fill="Transparent"
                     Stroke="{ThemeResource LamhaFieldLineBrush}" StrokeThickness="1" />
            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}" AutomationProperties.AccessibilityView="Raw" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A dropdown at the end of a settings card: 36 px high (the text boxes' height), 200 px at least, the inputs' corners -->
  <Style x:Key="LamhaComboStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
    <Setter Property="MinWidth" Value="200" />
    <Setter Property="MinHeight" Value="{StaticResource LamhaControlHeight}" />
    <Setter Property="CornerRadius" Value="{StaticResource LamhaRadiusControl}" />
    <Setter Property="FontFamily" Value="{StaticResource LamhaFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeBody}" />
  </Style>

  <!-- A text field and a key field in Settings: 36 px high (the dropdowns' and buttons' height), the inputs' corners -->
  <Style x:Key="LamhaFieldStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
    <Setter Property="MinHeight" Value="{StaticResource LamhaControlHeight}" />
    <Setter Property="CornerRadius" Value="{StaticResource LamhaRadiusControl}" />
    <Setter Property="FontFamily" Value="{StaticResource LamhaFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeBody}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="IsSpellCheckEnabled" Value="False" />
  </Style>
  <Style x:Key="LamhaPasswordStyle" TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
    <Setter Property="MinHeight" Value="{StaticResource LamhaControlHeight}" />
    <Setter Property="CornerRadius" Value="{StaticResource LamhaRadiusControl}" />
    <Setter Property="FontFamily" Value="{StaticResource LamhaFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeBody}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- The chosen AI provider's setup, under its choice: a line above it (the design's .sub), 12 px between its rows -->
  <Style x:Key="LamhaProviderSetupStyle" TargetType="StackPanel">
    <Setter Property="BorderBrush" Value="{ThemeResource LamhaLineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="0,12,0,16" />
    <Setter Property="Spacing" Value="12" />
  </Style>

  <!-- A switch at the end of a settings card: only the switch, without Windows' "On" / "Off" beside it. The 12 px
       Windows keeps between the switch and those words is taken back, so the switch ends where the dropdowns end. -->
  <Style x:Key="LamhaSettingsSwitchStyle" TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Margin" Value="0,0,-12,0" />
  </Style>

  <!-- A page in the main window's side pane: Windows' navigation item (36 px, 4 px corners, the selection mark at
       the start) in Lamha's colours, on a ListView so Lamha's line icons can be its icons -->
  <Style x:Key="LamhaNavItemStyle" TargetType="ListViewItem">
    <Setter Property="Foreground" Value="{ThemeResource LamhaTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeBody}" />
    <Setter Property="Margin" Value="4,2" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <ListViewItemPresenter
              Control.IsTemplateFocusTarget="True"
              ContentMargin="{TemplateBinding Padding}"
              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
              CornerRadius="{TemplateBinding CornerRadius}"
              FocusVisualMargin="{TemplateBinding FocusVisualMargin}"
              SelectionCheckMarkVisualEnabled="False"
              SelectionIndicatorVisualEnabled="True"
              SelectionIndicatorMode="Inline"
              SelectionIndicatorCornerRadius="1.5"
              SelectionIndicatorBrush="{ThemeResource LamhaAccentBrush}"
              SelectionIndicatorPointerOverBrush="{ThemeResource LamhaAccentBrush}"
              SelectionIndicatorPressedBrush="{ThemeResource LamhaAccentBrush}"
              PointerOverBackground="{ThemeResource LamhaNavHoverBrush}"
              PointerOverForeground="{ThemeResource LamhaTextBrush}"
              PressedBackground="{ThemeResource LamhaNavHoverBrush}"
              SelectedBackground="{ThemeResource LamhaNavSelectedBrush}"
              SelectedForeground="{ThemeResource LamhaNavSelectedTextBrush}"
              SelectedPointerOverBackground="{ThemeResource LamhaNavSelectedBrush}"
              SelectedPressedBackground="{ThemeResource LamhaNavSelectedBrush}"
              DisabledOpacity="0.45" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
