<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Lamha.App.Controls">
  <!-- Lamha's base controls, from the tokens (merged here so the styles can name them) and phase 1's signed-off
       designs: buttons (filled, quiet, delete, icon), chips, the switch in Lamha 2's green, and the boxes the screens
       repeat. tests/Lamha.Core.Tests/Appearance/TokensTests.cs checks that every Lamha resource named exists. -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="ms-appx:///Themes/Tokens.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- The switch, the pane's pill, the focus line: Windows' own, in Lamha's accent (Tokens.xaml's SystemAccentColor
       family) -->

  <!-- Lamha's mark: its gradient, which follows the theme (Windows' highlight in high contrast) -->
  <Style TargetType="controls:BrandMark">
    <Setter Property="Background" Value="{ThemeResource LamhaBrandBrush}" />
  </Style>

  <!-- A button in the title bar (🔍 when narrow): Windows' 40 × 36, subtle until the pointer is on it -->
  <Style x:Key="LamhaTitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource LamhaRadiusControl}" />
  </Style>

  <!-- The count beside Review in the pane, as Windows' InfoBadge (16 high, its 11 px number, the accent fill), with
       Lamha's own digits (Arabic ones in Arabic), which InfoBadge can't show -->
  <Style x:Key="LamhaNavBadgeStyle" TargetType="Border">
    <Setter Property="MinWidth" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="Margin" Value="0,0,12,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{ThemeResource LamhaButtonBrush}" />
  </Style>
  <Style x:Key="LamhaNavBadgeTextStyle" TargetType="TextBlock">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{StaticResource InfoBadgeValueFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource LamhaButtonTextBrush}" />
  </Style>

  <!-- Buttons: Windows' own (docs/design/system.md §6): 32 high, padding 11,5,11,6, radius 4, Body, Windows' fills,
       edges, hover and press. The accent button is the one main action of a view (Replace, Proofread, Next); the
       standard one sits beside it (Copy, Cancel); the subtle one is a tool (the card's bar, a row's actions). -->
  <Style x:Key="LamhaButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="MinHeight" Value="{StaticResource LamhaControlHeight}" />
  </Style>
  <Style x:Key="LamhaQuietButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="MinHeight" Value="{StaticResource LamhaControlHeight}" />
  </Style>
  <Style x:Key="LamhaSubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
    <Setter Property="MinHeight" Value="{StaticResource LamhaControlHeight}" />
  </Style>

  <!-- An icon alone (Copy, Listen, the card's bar): Windows' subtle button, 32 × 32 with a 16 icon; its name in its
       tooltip and AutomationProperties.Name -->
  <Style x:Key="LamhaIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Listen beside the headword: the main sound, its icon in the accent (the system's main icon button) -->
  <Style x:Key="LamhaMainIconButtonStyle" TargetType="Button" BasedOn="{StaticResource LamhaIconButtonStyle}">
    <Setter Property="Foreground" Value="{ThemeResource LamhaAccentBrush}" />
  </Style>

  <!-- A chip that does something once (a meaning or synonym to look up, "+3"): Windows' button as a pill, 28 high with
       Body (24 with Caption) -->
  <Style x:Key="LamhaChipButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="controls:Pill.IsPill" Value="True" />
    <Setter Property="Padding" Value="11,3" />
    <Setter Property="MinHeight" Value="{StaticResource LamhaMinTargetSize}" />
  </Style>

  <!-- A link to somewhere else (Google Translate, Cambridge, Read on Wikipedia): Windows' hyperlink button -->
  <Style x:Key="LamhaFootLinkStyle" TargetType="HyperlinkButton" BasedOn="{StaticResource DefaultHyperlinkButtonStyle}">
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="MinHeight" Value="{StaticResource LamhaMinTargetSize}" />
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeCaption}" />
  </Style>

  <!-- Lamha's own coloured buttons, where the colour is the meaning (Review's answers, Delete): Windows' size, corners and
       type, a hover tint over the fill, a little faded when pressed; Windows draws the focus ring -->
  <ControlTemplate x:Key="LamhaButtonTemplate" TargetType="Button">
    <Grid x:Name="Root"
          Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}"
          CornerRadius="{TemplateBinding CornerRadius}"
          Control.IsTemplateFocusTarget="True">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Target="Hover.Opacity" Value="1" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters>
              <Setter Target="Hover.Opacity" Value="1" />
              <Setter Target="Presenter.Opacity" Value="0.8" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Target="Root.Opacity" Value="0.45" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Border x:Name="Hover" Background="{ThemeResource LamhaHoverBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
      <ContentPresenter x:Name="Presenter"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        ContentTransitions="{TemplateBinding ContentTransitions}"
                        FontFamily="{TemplateBinding FontFamily}"
                        FontSize="{TemplateBinding FontSize}"
                        FontWeight="{TemplateBinding FontWeight}"
                        Foreground="{TemplateBinding Foreground}"
                        AutomationProperties.AccessibilityView="Raw" />
    </Grid>
  </ControlTemplate>
  <Style x:Key="LamhaPaintedButtonStyle" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource LamhaButtonTemplate}" />
    <Setter Property="BorderBrush" Value="{ThemeResource LamhaControlEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource LamhaRadiusControl}" />
    <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
    <Setter Property="MinHeight" Value="{StaticResource LamhaControlHeight}" />
    <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeBody}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
  </Style>

  <!-- Review's answers (Forgot / Hard / Knew it): the answer over when it brings the word back, filling its column;
       each sets its own tint and colour -->
  <Style x:Key="LamhaGradeButtonStyle" TargetType="Button" BasedOn="{StaticResource LamhaPaintedButtonStyle}">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="8" />
  </Style>

  <!-- "Delete" in a question (Lamha 2's dialog.js danger choice): the one red in both themes, white text at 4.8:1 -->
  <Style x:Key="LamhaDialogDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource LamhaPaintedButtonStyle}">
    <Setter Property="Background" Value="{ThemeResource LamhaDangerSolidBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource LamhaDangerSolidTextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- Deletes something: never looks like a harmless action (Lamha 2's btn.danger) -->
  <Style x:Key="LamhaDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource LamhaPaintedButtonStyle}">
    <Setter Property="Background" Value="{ThemeResource LamhaDangerSoftBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource LamhaDangerBrush}" />
  </Style>

  <!-- An icon that stays on (Pin, the star): Windows' subtle icon button, 32 × 32, its icon in the accent when on
       (the star also fills: FluentIcon.Filled) -->
  <Style x:Key="LamhaIconToggleStyle" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource LamhaControlEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource LamhaRadiusControl}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Control.IsTemplateFocusTarget="True">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Hover.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Hover.Opacity" Value="1" />
                    <Setter Target="Presenter.Opacity" Value="0.8" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.45" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource LamhaAccentBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource LamhaAccentBrush}" />
                    <Setter Target="Hover.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource LamhaAccentBrush}" />
                    <Setter Target="Presenter.Opacity" Value="0.8" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedDisabled">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource LamhaAccentBrush}" />
                    <Setter Target="Root.Opacity" Value="0.45" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Hover" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
            <ContentPresenter x:Name="Presenter"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              AutomationProperties.AccessibilityView="Raw" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A segment of a two-way switch in a pill (the card's العربية ⇄ English): the chosen one raised on the surface -->
  <Style x:Key="LamhaSwitchSegmentStyle" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource LamhaTextMutedBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="controls:Pill.IsPill" Value="True" />
    <Setter Property="Padding" Value="10,2" />
    <Setter Property="MinHeight" Value="{StaticResource LamhaMinTargetSize}" />
    <Setter Property="FontFamily" Value="{StaticResource LamhaFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Control.IsTemplateFocusTarget="True">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource LamhaTextBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Opacity" Value="0.8" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource LamhaSurfaceBrush}" />
                    <Setter Target="Root.BorderBrush" Value="{ThemeResource LamhaControlEdgeBrush}" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource LamhaTextBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource LamhaSurfaceBrush}" />
                    <Setter Target="Root.BorderBrush" Value="{ThemeResource LamhaControlEdgeBrush}" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource LamhaTextBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource LamhaSurfaceBrush}" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource LamhaTextBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter x:Name="Presenter"
                              Padding="{TemplateBinding Padding}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Content="{TemplateBinding Content}"
                              FontFamily="{TemplateBinding FontFamily}"
                              FontSize="{TemplateBinding FontSize}"
                              FontWeight="{TemplateBinding FontWeight}"
                              Foreground="{TemplateBinding Foreground}"
                              AutomationProperties.AccessibilityView="Raw" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Chips: a meaning, a writing tool, a choice, a filter. Windows' toggle button as a pill: on in the accent fill. -->
  <Style x:Key="LamhaChipStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
    <Setter Property="controls:Pill.IsPill" Value="True" />
    <Setter Property="Padding" Value="11,3" />
    <Setter Property="MinHeight" Value="{StaticResource LamhaMinTargetSize}" />
  </Style>

  <!-- A skeleton: the grey shape of what's coming, with a light sweeping across it (Controls/Skeleton.cs moves it) -->
  <Style TargetType="controls:Skeleton">
    <Setter Property="Background" Value="{ThemeResource LamhaSkeletonBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource LamhaRadiusControl}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:Skeleton">
          <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
            <Rectangle x:Name="Shine" Visibility="Collapsed">
              <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Offset="0" Color="#00FFFFFF" />
                  <GradientStop Offset="0.5" Color="{ThemeResource LamhaShimmerColor}" />
                  <GradientStop Offset="1" Color="#00FFFFFF" />
                </LinearGradientBrush>
              </Rectangle.Fill>
              <Rectangle.RenderTransform>
                <TranslateTransform x:Name="Move" />
              </Rectangle.RenderTransform>
            </Rectangle>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A content card (the answer, Today, the journal's list): Windows' card fill and edge, rounded 8, 24 in. Never a
       card inside a card. -->
  <Style x:Key="LamhaContentCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource LamhaRadiusOverlay}" />
    <Setter Property="Padding" Value="{StaticResource LamhaContentCardPadding}" />
  </Style>
  <!-- The tinted box the meaning sits in on the card, and the corrected text -->
  <Style x:Key="LamhaTintedBoxStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource LamhaAccentSoftBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource LamhaRadiusControl}" />
    <Setter Property="Padding" Value="16,12" />
  </Style>

  <!-- The links under a content card's content (Google Translate, Cambridge): a divider above, their text in line with
       the card's 24 (each link's own 4 inside) -->
  <Style x:Key="LamhaCardFootStyle" TargetType="Border">
    <Setter Property="Padding" Value="20,8" />
    <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>

  <!-- Fields: Windows' text box (32 high, padding 10,5,6,6, radius 4, its 2 px accent line under it when focused).
       The large one is a box to write in (Translate, Write): Body large, wrapping, room at its end for the clear button. -->
  <Style x:Key="LamhaLargeFieldStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
    <Setter Property="MinHeight" Value="72" />
    <Setter Property="MaxHeight" Value="160" />
    <Setter Property="Padding" Value="12,8,40,8" />
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeBodyLarge}" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="IsSpellCheckEnabled" Value="False" />
    <Setter Property="TextReadingOrder" Value="DetectFromContent" />
  </Style>
  <!-- A search box (History, Clipboard): Windows' field, 32 high, 🔍 at its end (LamhaFieldGlyphStyle over it); it
       searches as you type, so the icon is a sign, not a button -->
  <Style x:Key="LamhaSearchFieldStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
    <Setter Property="MinHeight" Value="{StaticResource LamhaControlHeight}" />
    <Setter Property="Padding" Value="10,5,36,6" />
    <Setter Property="IsSpellCheckEnabled" Value="False" />
    <Setter Property="TextReadingOrder" Value="DetectFromContent" />
  </Style>
  <Style x:Key="LamhaFieldGlyphStyle" TargetType="controls:FluentIcon">
    <Setter Property="Margin" Value="0,0,12,0" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <!-- The draft (Write): the large field, taller, in Body, with no clear button -->
  <Style x:Key="LamhaDraftFieldStyle" TargetType="TextBox" BasedOn="{StaticResource LamhaLargeFieldStyle}">
    <Setter Property="MinHeight" Value="120" />
    <Setter Property="MaxHeight" Value="320" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeBody}" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
  </Style>

  <!-- The × at the top end of a large field: 24, a 12 icon, centred on the first line -->
  <Style x:Key="LamhaFieldClearButtonStyle" TargetType="Button" BasedOn="{StaticResource LamhaIconButtonStyle}">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Margin" Value="0,8,8,0" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
  </Style>

  <!-- A key cap (Ctrl, Alt, L): Caption in the secondary colour on Windows' control fill and its edge, rounded 4 -->
  <Style x:Key="LamhaKeyCapStyle" TargetType="Border">
    <Setter Property="Padding" Value="4,1" />
    <Setter Property="CornerRadius" Value="{StaticResource LamhaRadiusControl}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlElevationBorderBrush}" />
    <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
  </Style>
  <Style x:Key="LamhaKeyCapTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LamhaCaptionTextStyle}">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <!-- A section's heading with the line after it ("Other meanings ———"): a Grid of the heading and a 1 px line -->
  <Style x:Key="LamhaSectionRowStyle" TargetType="Grid">
    <Setter Property="ColumnSpacing" Value="8" />
    <Setter Property="Margin" Value="0,20,0,8" />
  </Style>

  <!-- Chips in lines that wrap: meanings, synonyms, choices -->
  <ItemsPanelTemplate x:Key="LamhaWrapChipsPanel">
    <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="4" />
  </ItemsPanelTemplate>

  <!-- A row that does something (a recent lookup): the whole row is Windows' subtle button, 40 high at least (a list
       row's height). Its text is 10 px in, the 1 px edge (seen in high contrast) included, so it lines up with the text
       around it. -->
  <Style x:Key="LamhaRowButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- A link in a line of text (Clear, See its meaning): Windows' hyperlink button, its text where the line's text is
       (the padding taken back by the margin), so only its hover fill reaches past it -->
  <Style x:Key="LamhaLinkButtonStyle" TargetType="HyperlinkButton" BasedOn="{StaticResource DefaultHyperlinkButtonStyle}">
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Margin" Value="-4,-2" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <!-- ===== Settings (Windows' Settings, docs/design/system.md §6) ===== -->

  <!-- A group's heading over its cards (Body strong): in a stack of cards 4 apart, 8 above its first card -->
  <Style x:Key="LamhaGroupHeadingTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LamhaSectionHeadingTextStyle}">
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <!-- A setting card (Windows' Settings): Windows' card fill and edge, rounded 4, 68 high at least (a short one sets
       48); the text 16 from the edge, the edge included; the icon 20, 20 before the text; the name in Body over its hint
       in Caption. A card that holds more than one control is a Border in LamhaSettingsPanelStyle. -->
  <Style x:Key="LamhaSettingsPanelStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource LamhaRadiusControl}" />
    <Setter Property="Padding" Value="15,11" />
    <Setter Property="MinHeight" Value="68" />
  </Style>
  <Style TargetType="controls:SettingsCard">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource LamhaRadiusControl}" />
    <Setter Property="Padding" Value="15,11" />
    <Setter Property="MinHeight" Value="68" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:SettingsCard">
          <Grid Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}"
                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <controls:FluentIcon x:Name="IconBox" Margin="0,0,20,0" VerticalAlignment="Center" Size="Large" Glyph="{TemplateBinding Icon}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource LamhaBodyTextStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextReadingOrder="UseFlowDirection" Text="{TemplateBinding Header}" />
              <TextBlock x:Name="Description" Style="{StaticResource LamhaCaptionTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         TextReadingOrder="UseFlowDirection" Text="{TemplateBinding Description}" />
            </StackPanel>
            <ContentPresenter x:Name="Control" Grid.Column="2" VerticalAlignment="Center" Content="{TemplateBinding Content}" />
            <ContentPresenter x:Name="DetailBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Content="{TemplateBinding Detail}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A setting card that opens a page (Settings' home): the card on Windows' button, its hover and press; the chevron
       at its end is the content's -->
  <Style x:Key="LamhaTileButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="Padding" Value="15,11" />
    <Setter Property="MinHeight" Value="68" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <!-- The breadcrumb's "Settings": the page title's size in the tertiary colour, the secondary under the pointer (Windows' Settings) -->
  <Style x:Key="LamhaCrumbButtonStyle" TargetType="HyperlinkButton">
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource LamhaFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="HyperlinkButton">
          <ContentPresenter x:Name="Presenter" Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                            FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                            Background="Transparent" Control.IsTemplateFocusTarget="True" AutomationProperties.AccessibilityView="Raw">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Setter Target="Presenter.Opacity" Value="0.8" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </ContentPresenter>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A choice among a few, with its hint (Translation, Without internet, the AI provider): Windows' radio button (its
       20 ring, the accent when chosen), the first line beside the ring; 4 above and below, so the lines between choices
       sit in the middle -->
  <Style x:Key="LamhaRadioStyle" TargetType="RadioButton" BasedOn="{StaticResource DefaultRadioButtonStyle}">
    <Setter Property="Padding" Value="12,6,0,0" />
    <Setter Property="Margin" Value="0,4" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <!-- A line between the choices in a card -->
  <Style x:Key="LamhaDividerStyle" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
  </Style>

  <!-- A dropdown at the end of a setting card: Windows' 32 high, 200 wide at least, radius 4 -->
  <Style x:Key="LamhaComboStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
    <Setter Property="MinWidth" Value="200" />
    <Setter Property="MinHeight" Value="{StaticResource LamhaControlHeight}" />
    <Setter Property="CornerRadius" Value="{StaticResource LamhaRadiusControl}" />
    <Setter Property="FontFamily" Value="{StaticResource LamhaFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeBody}" />
  </Style>

  <!-- A text field and a key field in Settings: Windows' 32 high, radius 4 -->
  <Style x:Key="LamhaFieldStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
    <Setter Property="MinHeight" Value="{StaticResource LamhaControlHeight}" />
    <Setter Property="CornerRadius" Value="{StaticResource LamhaRadiusControl}" />
    <Setter Property="FontFamily" Value="{StaticResource LamhaFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeBody}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="IsSpellCheckEnabled" Value="False" />
  </Style>
  <Style x:Key="LamhaPasswordStyle" TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
    <Setter Property="MinHeight" Value="{StaticResource LamhaControlHeight}" />
    <Setter Property="CornerRadius" Value="{StaticResource LamhaRadiusControl}" />
    <Setter Property="FontFamily" Value="{StaticResource LamhaFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeBody}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- The chosen AI provider's setup, under its choice: a line above it (the design's .sub), 12 px between its rows -->
  <Style x:Key="LamhaProviderSetupStyle" TargetType="StackPanel">
    <Setter Property="BorderBrush" Value="{ThemeResource LamhaLineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="0,12,0,16" />
    <Setter Property="Spacing" Value="12" />
  </Style>

  <!-- A switch at the end of a settings card: only the switch, without Windows' "On" / "Off" beside it. The 12 px
       Windows keeps between the switch and those words is taken back, so the switch ends where the dropdowns end. -->
  <Style x:Key="LamhaSettingsSwitchStyle" TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Margin" Value="0,0,-12,0" />
  </Style>

</ResourceDictionary>
