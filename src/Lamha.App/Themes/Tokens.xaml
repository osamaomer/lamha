<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Lamha's design tokens. Phase 0 has only what the prototype card needs; phase 1 brings the full set
       (colours from Lamha 2's shared/ui.css for light, dark and high contrast, type, spacing, motion). -->

  <!-- Corners: the same three steps as Lamha 2's r-sm, r-md and r-lg. -->
  <CornerRadius x:Key="LamhaRadiusSmall">8</CornerRadius>
  <CornerRadius x:Key="LamhaRadiusMedium">10</CornerRadius>
  <CornerRadius x:Key="LamhaRadiusLarge">14</CornerRadius>

  <!-- Spacing: a 4 px grid. -->
  <x:Double x:Key="LamhaSpace1">4</x:Double>
  <x:Double x:Key="LamhaSpace2">8</x:Double>
  <x:Double x:Key="LamhaSpace3">12</x:Double>
  <x:Double x:Key="LamhaSpace4">16</x:Double>
  <Thickness x:Key="LamhaCardPadding">16</Thickness>
</ResourceDictionary>
