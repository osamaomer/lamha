<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Lamha's design tokens: colours, type, spacing, corners and the card's backdrop. Animation timings are in
       Lamha.Core/Appearance/Motion.cs. The colours are Lamha 2's (shared/ui.css, and the card's own in
       content/styles.js), and tests/Lamha.Core.Tests/Appearance/TokensTests.cs checks that they still match it, that
       text reaches WCAG AA in both themes, and that high contrast uses only Windows' own colours. -->

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <!-- Grounds: the page (ui.css's bg) and what sits on it, cards and panels (its surface) -->
      <SolidColorBrush x:Key="LamhaPageBrush" Color="#F5F5F7" />
      <SolidColorBrush x:Key="LamhaSurfaceBrush" Color="#FFFFFF" />
      <!-- Text: main, secondary (4.5:1 also on the tints), and headings and hints (4.5:1 on the page) -->
      <SolidColorBrush x:Key="LamhaTextBrush" Color="#1D1D1F" />
      <SolidColorBrush x:Key="LamhaTextMutedBrush" Color="#5F5F64" />
      <SolidColorBrush x:Key="LamhaTextFaintBrush" Color="#707075" />
      <!-- Edges: dividers, and the edge of text boxes and dropdowns (3:1, so they can be found: WCAG 1.4.11) -->
      <SolidColorBrush x:Key="LamhaLineBrush" Color="#14000000" />
      <SolidColorBrush x:Key="LamhaFieldLineBrush" Color="#6B000000" />
      <SolidColorBrush x:Key="LamhaHoverBrush" Color="#0D000000" />
      <!-- The edge of buttons and chips: none here, the text colour in high contrast (their fills disappear there) -->
      <SolidColorBrush x:Key="LamhaControlEdgeBrush" Color="#00000000" />
      <!-- Chips and quiet buttons, and the shapes that stand in for an answer while it loads -->
      <SolidColorBrush x:Key="LamhaChipBrush" Color="#0B000000" />
      <SolidColorBrush x:Key="LamhaSkeletonBrush" Color="#0F000000" />
      <!-- The accent: links, labels, icons; its tint behind what's selected; filled buttons and selected chips.
           Services/AccentService.cs repaints these four with Windows' accent, made readable, when Settings asks. -->
      <SolidColorBrush x:Key="LamhaAccentBrush" Color="#4F46E5" />
      <SolidColorBrush x:Key="LamhaAccentSoftBrush" Color="#174F46E5" />
      <SolidColorBrush x:Key="LamhaButtonBrush" Color="#4F46E5" />
      <SolidColorBrush x:Key="LamhaButtonTextBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="LamhaAccentTextBrush" Color="#FFFFFF" />
      <!-- Success, and what deletes something (never looks like a harmless action) -->
      <SolidColorBrush x:Key="LamhaOkBrush" Color="#166534" />
      <SolidColorBrush x:Key="LamhaOkSoftBrush" Color="#1F16A34A" />
      <SolidColorBrush x:Key="LamhaDangerBrush" Color="#C81E1E" />
      <SolidColorBrush x:Key="LamhaDangerSoftBrush" Color="#1ADC2626" />
      <!-- One red in both themes for "delete" in a question (white text at 4.8:1), and the switch when on -->
      <SolidColorBrush x:Key="LamhaDangerSolidBrush" Color="#DC2626" />
      <SolidColorBrush x:Key="LamhaDangerSolidTextBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="LamhaSwitchOnBrush" Color="#2E9E4F" />
      <!-- A warning banner -->
      <SolidColorBrush x:Key="LamhaWarnBackgroundBrush" Color="#FFF7E6" />
      <SolidColorBrush x:Key="LamhaWarnTextBrush" Color="#8A5300" />
      <!-- Toasts stand out from what's behind them: dark on light, light on dark -->
      <SolidColorBrush x:Key="LamhaToastBackgroundBrush" Color="#1C1C1E" />
      <SolidColorBrush x:Key="LamhaToastTextBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="LamhaToastActionBrush" Color="#A5B4FC" />
      <!-- The Lamha mark, and milestones -->
      <LinearGradientBrush x:Key="LamhaBrandBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#6366F1" />
        <GradientStop Offset="1" Color="#06B6D4" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="LamhaCelebrateBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#1C4F46E5" />
        <GradientStop Offset="1" Color="#1C06B6D4" />
      </LinearGradientBrush>
      <!-- The card's Acrylic: a strong tint of the surface, so text over busy pages stays readable. Windows shows
           the fallback when transparency effects are off, on battery saver, and with Appearance → solid. -->
      <Color x:Key="LamhaCardTintColor">#FFFFFF</Color>
      <Color x:Key="LamhaCardFallbackColor">#FFFFFF</Color>
      <x:Double x:Key="LamhaCardTintOpacity">0.85</x:Double>
      <x:Double x:Key="LamhaCardLuminosityOpacity">0.9</x:Double>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="LamhaPageBrush" Color="#1C1C1E" />
      <SolidColorBrush x:Key="LamhaSurfaceBrush" Color="#2C2C2E" />
      <SolidColorBrush x:Key="LamhaTextBrush" Color="#F5F5F7" />
      <SolidColorBrush x:Key="LamhaTextMutedBrush" Color="#A5A5AA" />
      <SolidColorBrush x:Key="LamhaTextFaintBrush" Color="#98989D" />
      <SolidColorBrush x:Key="LamhaLineBrush" Color="#1AFFFFFF" />
      <SolidColorBrush x:Key="LamhaFieldLineBrush" Color="#66FFFFFF" />
      <SolidColorBrush x:Key="LamhaHoverBrush" Color="#12FFFFFF" />
      <SolidColorBrush x:Key="LamhaControlEdgeBrush" Color="#00000000" />
      <SolidColorBrush x:Key="LamhaChipBrush" Color="#12FFFFFF" />
      <SolidColorBrush x:Key="LamhaSkeletonBrush" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="LamhaAccentBrush" Color="#9AA1FF" />
      <SolidColorBrush x:Key="LamhaAccentSoftBrush" Color="#1F9AA1FF" />
      <SolidColorBrush x:Key="LamhaButtonBrush" Color="#5E5CE6" />
      <SolidColorBrush x:Key="LamhaButtonTextBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="LamhaAccentTextBrush" Color="#0B0B12" />
      <SolidColorBrush x:Key="LamhaOkBrush" Color="#4ADE80" />
      <SolidColorBrush x:Key="LamhaOkSoftBrush" Color="#214ADE80" />
      <SolidColorBrush x:Key="LamhaDangerBrush" Color="#FC8888" />
      <SolidColorBrush x:Key="LamhaDangerSoftBrush" Color="#24FC8888" />
      <SolidColorBrush x:Key="LamhaDangerSolidBrush" Color="#DC2626" />
      <SolidColorBrush x:Key="LamhaDangerSolidTextBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="LamhaSwitchOnBrush" Color="#2E9E4F" />
      <SolidColorBrush x:Key="LamhaWarnBackgroundBrush" Color="#3A2C12" />
      <SolidColorBrush x:Key="LamhaWarnTextBrush" Color="#F5C46B" />
      <SolidColorBrush x:Key="LamhaToastBackgroundBrush" Color="#F5F2F2F7" />
      <SolidColorBrush x:Key="LamhaToastTextBrush" Color="#1C1C1E" />
      <SolidColorBrush x:Key="LamhaToastActionBrush" Color="#4F46E5" />
      <LinearGradientBrush x:Key="LamhaBrandBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#6366F1" />
        <GradientStop Offset="1" Color="#06B6D4" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="LamhaCelebrateBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#388B93FF" />
        <GradientStop Offset="1" Color="#2122D3EE" />
      </LinearGradientBrush>
      <Color x:Key="LamhaCardTintColor">#2C2C2E</Color>
      <Color x:Key="LamhaCardFallbackColor">#2C2C2E</Color>
      <x:Double x:Key="LamhaCardTintOpacity">0.85</x:Double>
      <x:Double x:Key="LamhaCardLuminosityOpacity">0.9</x:Double>
    </ResourceDictionary>

    <!-- High contrast: only the colours of the user's contrast theme. Edges are drawn in the text colour, so every
         box and field can still be seen (Lamha 2's forced-colors rules). -->
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="LamhaPageBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="LamhaSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="LamhaTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="LamhaTextMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="LamhaTextFaintBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="LamhaLineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="LamhaFieldLineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="LamhaHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="LamhaControlEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="LamhaChipBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="LamhaSkeletonBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="LamhaAccentBrush" Color="{ThemeResource SystemColorHotlightColor}" />
      <SolidColorBrush x:Key="LamhaAccentSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="LamhaButtonBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="LamhaButtonTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="LamhaAccentTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="LamhaOkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="LamhaOkSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="LamhaDangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="LamhaDangerSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="LamhaDangerSolidBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="LamhaDangerSolidTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="LamhaSwitchOnBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="LamhaWarnBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="LamhaWarnTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="LamhaToastBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="LamhaToastTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="LamhaToastActionBrush" Color="{ThemeResource SystemColorHotlightColor}" />
      <SolidColorBrush x:Key="LamhaBrandBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="LamhaCelebrateBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <StaticResource x:Key="LamhaCardTintColor" ResourceKey="SystemColorWindowColor" />
      <StaticResource x:Key="LamhaCardFallbackColor" ResourceKey="SystemColorWindowColor" />
      <x:Double x:Key="LamhaCardTintOpacity">1</x:Double>
      <x:Double x:Key="LamhaCardLuminosityOpacity">1</x:Double>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Type: Segoe UI Variable for Latin and Segoe UI's Arabic, as Lamha 2 shows on Windows (phase 1's answer). The
       English headword keeps Lamha 2's serif. Sizes are Lamha 2's card sizes, gathered into one scale; Arabic gets
       the taller lines it had (1.7 for reading, 1.5 for the rest). -->
  <FontFamily x:Key="LamhaFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="LamhaHeadwordFontFamily">Palatino Linotype, Georgia</FontFamily>

  <x:Double x:Key="LamhaFontSizeHeadword">26</x:Double>
  <x:Double x:Key="LamhaFontSizeHero">22</x:Double>
  <x:Double x:Key="LamhaFontSizeHeroLong">16.5</x:Double>
  <x:Double x:Key="LamhaFontSizeTitle">15</x:Double>
  <x:Double x:Key="LamhaFontSizeReading">14.5</x:Double>
  <x:Double x:Key="LamhaFontSizeBody">14</x:Double>
  <x:Double x:Key="LamhaFontSizeSecondary">13</x:Double>
  <x:Double x:Key="LamhaFontSizeCaption">12</x:Double>
  <x:Double x:Key="LamhaFontSizeSectionHeading">11.5</x:Double>
  <x:Double x:Key="LamhaFontSizeLabel">11</x:Double>

  <Style x:Key="LamhaTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource LamhaFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeBody}" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="Foreground" Value="{ThemeResource LamhaTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- The English word looked up -->
  <Style x:Key="LamhaHeadwordTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LamhaTextStyle}">
    <Setter Property="FontFamily" Value="{StaticResource LamhaHeadwordFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeHeadword}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LineHeight" Value="30" />
    <Setter Property="CharacterSpacing" Value="-10" />
  </Style>
  <!-- The meaning in context -->
  <Style x:Key="LamhaHeroTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LamhaTextStyle}">
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeHero}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LineHeight" Value="30" />
  </Style>
  <!-- A sentence's translation -->
  <Style x:Key="LamhaHeroLongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LamhaTextStyle}">
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeHeroLong}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LineHeight" Value="29" />
  </Style>
  <!-- An Arabic meaning in the list, a question's or an error's title -->
  <Style x:Key="LamhaTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LamhaTextStyle}">
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeTitle}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LineHeight" Value="24" />
  </Style>
  <!-- Running Arabic text: glosses, the written text, Wikipedia -->
  <Style x:Key="LamhaReadingTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LamhaTextStyle}">
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeReading}" />
    <Setter Property="LineHeight" Value="25" />
  </Style>
  <Style x:Key="LamhaBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LamhaTextStyle}" />
  <!-- English glosses, examples, explanations -->
  <Style x:Key="LamhaSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LamhaTextStyle}">
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeSecondary}" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Foreground" Value="{ThemeResource LamhaTextMutedBrush}" />
  </Style>
  <!-- Part of speech, the footer, small links -->
  <Style x:Key="LamhaCaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LamhaTextStyle}">
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeCaption}" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="{ThemeResource LamhaTextMutedBrush}" />
  </Style>
  <!-- "Other meanings", "Wikipedia" -->
  <Style x:Key="LamhaSectionHeadingTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LamhaTextStyle}">
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeSectionHeading}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LineHeight" Value="17" />
    <Setter Property="CharacterSpacing" Value="20" />
    <Setter Property="Foreground" Value="{ThemeResource LamhaTextFaintBrush}" />
  </Style>
  <!-- Badges, "In this context", key hints -->
  <Style x:Key="LamhaLabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LamhaTextStyle}">
    <Setter Property="FontSize" Value="{StaticResource LamhaFontSizeLabel}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LineHeight" Value="16" />
  </Style>

  <!-- Corners: Lamha 2's r-sm (buttons, small boxes), r-md (inputs, answer and meaning boxes), r-lg (cards and
       panels inside a window), and the pill (chips, switches). The card's own window keeps Windows' 8 px corners,
       edge and shadow, which Acrylic needs (phase 1's card design). -->
  <CornerRadius x:Key="LamhaRadiusSmall">8</CornerRadius>
  <CornerRadius x:Key="LamhaRadiusMedium">10</CornerRadius>
  <CornerRadius x:Key="LamhaRadiusLarge">14</CornerRadius>
  <CornerRadius x:Key="LamhaRadiusPill">999</CornerRadius>

  <!-- Spacing: a 4 px grid, named by how many steps of 4 -->
  <x:Double x:Key="LamhaSpace1">4</x:Double>
  <x:Double x:Key="LamhaSpace2">8</x:Double>
  <x:Double x:Key="LamhaSpace3">12</x:Double>
  <x:Double x:Key="LamhaSpace4">16</x:Double>
  <x:Double x:Key="LamhaSpace5">20</x:Double>
  <x:Double x:Key="LamhaSpace6">24</x:Double>
  <x:Double x:Key="LamhaSpace8">32</x:Double>
  <x:Double x:Key="LamhaSpace10">40</x:Double>
  <Thickness x:Key="LamhaCardPadding">16</Thickness>

  <!-- Sizes: text boxes, dropdowns and the buttons next to them line up (Lamha 2's control-h), and nothing that
       can be clicked is smaller than 24 px (WCAG 2.5.8) -->
  <x:Double x:Key="LamhaControlHeight">36</x:Double>
  <x:Double x:Key="LamhaMinTargetSize">24</x:Double>
</ResourceDictionary>
