<UserControl
    x:Class="Lamha.App.Views.ReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Lamha.App.Controls">
  <!-- The main window's Review page, as signed off in phase 1 (docs/design/main-window.html): due and new, the totals,
       the progress through this sitting; the flashcard (at least 280 px, everything centred, its parts 12 px apart and
       at most 420 px wide); Show meaning (Space), then Forgot / Hard / Knew it (1 / 2 / 3) with their intervals. -->

  <Grid>
  <StackPanel x:Name="Root" KeyDown="OnKeyDown">
    <!-- ===== Due and new, the totals ===== -->
    <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.IsRead, Mode=OneWay}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid>
        <Border Padding="10,3" controls:Pill.IsPill="True" Background="{ThemeResource LamhaAccentSoftBrush}" Visibility="{x:Bind ViewModel.HasDue, Mode=OneWay}">
          <TextBlock Style="{StaticResource LamhaCaptionTextStyle}" FontWeight="Bold" Foreground="{ThemeResource LamhaAccentBrush}" Text="{x:Bind ViewModel.DueText, Mode=OneWay}" />
        </Border>
        <!-- Nothing waiting: quiet (Lamha 2's .zero) -->
        <Border Padding="10,3" controls:Pill.IsPill="True" Background="{ThemeResource LamhaHoverBrush}" Visibility="{x:Bind controls:Show.IfNot(ViewModel.HasDue), Mode=OneWay}">
          <TextBlock Style="{StaticResource LamhaCaptionTextStyle}" FontWeight="Bold" Text="{x:Bind ViewModel.DueText, Mode=OneWay}" />
        </Border>
      </Grid>
      <Grid Grid.Column="1">
        <Border Padding="10,3" controls:Pill.IsPill="True" Background="{ThemeResource LamhaOkSoftBrush}" Visibility="{x:Bind ViewModel.HasFresh, Mode=OneWay}">
          <TextBlock Style="{StaticResource LamhaCaptionTextStyle}" FontWeight="Bold" Foreground="{ThemeResource LamhaOkBrush}" Text="{x:Bind ViewModel.FreshText, Mode=OneWay}" />
        </Border>
        <Border Padding="10,3" controls:Pill.IsPill="True" Background="{ThemeResource LamhaHoverBrush}" Visibility="{x:Bind controls:Show.IfNot(ViewModel.HasFresh), Mode=OneWay}">
          <TextBlock Style="{StaticResource LamhaCaptionTextStyle}" FontWeight="Bold" Text="{x:Bind ViewModel.FreshText, Mode=OneWay}" />
        </Border>
      </Grid>
      <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource LamhaCaptionTextStyle}" FontSize="12.5"
                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{x:Bind ViewModel.Totals, Mode=OneWay}" />
    </Grid>

    <!-- This sitting's progress: from the start side, once a card has been answered -->
    <Grid Height="4" Margin="0,12,0,0" CornerRadius="2" Background="{ThemeResource LamhaChipBrush}" Visibility="{x:Bind ViewModel.HasProgress, Mode=OneWay}"
          AutomationProperties.Name="{x:Bind ProgressLabel}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{x:Bind controls:Show.Filled(ViewModel.Progress), Mode=OneWay}" />
        <ColumnDefinition Width="{x:Bind controls:Show.Unfilled(ViewModel.Progress), Mode=OneWay}" />
      </Grid.ColumnDefinitions>
      <Border CornerRadius="2" Background="{ThemeResource LamhaButtonBrush}" />
    </Grid>

    <!-- ===== The flashcard ===== -->
    <Border x:Name="CardBox" Margin="0,16,0,0" MinHeight="280" Padding="24,28,24,20" Style="{StaticResource LamhaPanelStyle}" Visibility="{x:Bind ViewModel.IsCard, Mode=OneWay}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The front: a new word's tag, the word, its sentence with the word marked -->
        <StackPanel HorizontalAlignment="Center" Spacing="12">
          <Border Padding="8,0" HorizontalAlignment="Center" controls:Pill.IsPill="True" Background="{ThemeResource LamhaOkSoftBrush}"
                  Visibility="{x:Bind ViewModel.IsNew, Mode=OneWay}">
            <TextBlock Style="{StaticResource LamhaLabelTextStyle}" Foreground="{ThemeResource LamhaOkBrush}" Text="{x:Bind NewWord}" />
          </Border>
          <TextBlock HorizontalAlignment="Center" Style="{StaticResource LamhaHeadwordTextStyle}" FontSize="30" LineHeight="36" FlowDirection="LeftToRight"
                     TextAlignment="Center" Text="{x:Bind ViewModel.Word, Mode=OneWay}" IsTextSelectionEnabled="True" />
          <TextBlock MaxWidth="420" HorizontalAlignment="Center" Style="{StaticResource LamhaReadingTextStyle}" Foreground="{ThemeResource LamhaTextMutedBrush}"
                     FlowDirection="LeftToRight" TextAlignment="Center" Visibility="{x:Bind ViewModel.HasExample, Mode=OneWay}">
            <Run Text="{x:Bind ViewModel.ExampleBefore, Mode=OneWay}" /><Run Text="{x:Bind ViewModel.ExampleWord, Mode=OneWay}" FontWeight="Bold"
                 Foreground="{ThemeResource LamhaTextBrush}" /><Run Text="{x:Bind ViewModel.ExampleAfter, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>

        <!-- Show meaning, at the foot of the card -->
        <Button x:Name="ShowButton" Grid.Row="2" MaxWidth="420" Margin="0,12,0,0" HorizontalAlignment="Stretch" Style="{StaticResource LamhaButtonStyle}"
                Command="{x:Bind ViewModel.RevealCommand}" Visibility="{x:Bind controls:Show.IfNot(ViewModel.IsShown), Mode=OneWay}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock VerticalAlignment="Center" Text="{x:Bind ShowLabel}" />
            <Border Padding="5,1" VerticalAlignment="Center" CornerRadius="5" Background="#2EFFFFFF">
              <TextBlock FontSize="{StaticResource LamhaFontSizeLabel}" FontWeight="Normal" Text="Space" />
            </Border>
          </StackPanel>
        </Button>

        <!-- The back: the meaning (or the definition first) under a dashed line; the three answers; Remove -->
        <StackPanel x:Name="BackBox" Grid.Row="2" MaxWidth="420" Margin="0,12,0,0" Spacing="12" Visibility="{x:Bind ViewModel.IsShown, Mode=OneWay}">
          <StackPanel Spacing="2">
            <Line X1="0" X2="420" Stretch="Fill" Stroke="{ThemeResource LamhaLineBrush}" StrokeThickness="1" StrokeDashArray="4,3" />
            <TextBlock Margin="0,12,0,0" Style="{StaticResource LamhaHeroTextStyle}" TextAlignment="Center"
                       FlowDirection="{x:Bind ViewModel.BackMainFlow, Mode=OneWay}" Text="{x:Bind ViewModel.BackMain, Mode=OneWay}" IsTextSelectionEnabled="True" />
            <TextBlock Style="{StaticResource LamhaSecondaryTextStyle}" TextAlignment="Center" FlowDirection="{x:Bind ViewModel.BackSubFlow, Mode=OneWay}"
                       Text="{x:Bind ViewModel.BackSub, Mode=OneWay}" Visibility="{x:Bind controls:Show.IfText(ViewModel.BackSub), Mode=OneWay}" />
          </StackPanel>
          <Grid x:Name="GradesBox" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="AgainButton" Style="{StaticResource LamhaGradeButtonStyle}" Background="{ThemeResource LamhaDangerSoftBrush}" Foreground="{ThemeResource LamhaDangerBrush}"
                    Command="{x:Bind ViewModel.GradeAgainCommand}" ToolTipService.ToolTip="{x:Bind KeyOne}" AutomationProperties.AcceleratorKey="1">
              <StackPanel>
                <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="{x:Bind AgainLabel}" />
                <TextBlock HorizontalAlignment="Center" FontSize="{StaticResource LamhaFontSizeLabel}" Opacity="0.8" Text="{x:Bind ViewModel.AgainIn, Mode=OneWay}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="1" Style="{StaticResource LamhaGradeButtonStyle}" Background="{ThemeResource LamhaChipBrush}" Foreground="{ThemeResource LamhaTextBrush}"
                    Command="{x:Bind ViewModel.GradeHardCommand}" ToolTipService.ToolTip="{x:Bind KeyTwo}" AutomationProperties.AcceleratorKey="2">
              <StackPanel>
                <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="{x:Bind HardLabel}" />
                <TextBlock HorizontalAlignment="Center" FontSize="{StaticResource LamhaFontSizeLabel}" Opacity="0.8" Text="{x:Bind ViewModel.HardIn, Mode=OneWay}" />
              </StackPanel>
            </Button>
            <Button x:Name="GoodButton" Grid.Column="2" Style="{StaticResource LamhaGradeButtonStyle}" Background="{ThemeResource LamhaOkSoftBrush}" Foreground="{ThemeResource LamhaOkBrush}"
                    Command="{x:Bind ViewModel.GradeGoodCommand}" ToolTipService.ToolTip="{x:Bind KeyThree}" AutomationProperties.AcceleratorKey="3">
              <StackPanel>
                <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="{x:Bind GoodLabel}" />
                <TextBlock HorizontalAlignment="Center" FontSize="{StaticResource LamhaFontSizeLabel}" Opacity="0.8" Text="{x:Bind ViewModel.GoodIn, Mode=OneWay}" />
              </StackPanel>
            </Button>
          </Grid>
          <HyperlinkButton x:Name="RemoveLink" HorizontalAlignment="Center" Style="{StaticResource LamhaLinkButtonStyle}" Command="{x:Bind ViewModel.RemoveCommand}">
            <TextBlock Style="{StaticResource LamhaCaptionTextStyle}" FontSize="12.5" FontWeight="Medium" Text="{x:Bind RemoveLabel}" />
          </HyperlinkButton>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== Nothing to review now: what this sitting did, the next review, the streak ===== -->
    <Border x:Name="DoneBox" Margin="0,16,0,0" Style="{StaticResource LamhaPanelStyle}" Visibility="{x:Bind ViewModel.IsDone, Mode=OneWay}">
      <StackPanel Padding="8,8,8,4" Spacing="4" AutomationProperties.LiveSetting="Polite">
        <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource LamhaTitleTextStyle}" FontSize="16" Text="{x:Bind DoneTitle}" />
        <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource LamhaSecondaryTextStyle}" FontWeight="SemiBold"
                   Foreground="{ThemeResource LamhaTextBrush}" Text="{x:Bind ViewModel.Session, Mode=OneWay}" Visibility="{x:Bind controls:Show.IfText(ViewModel.Session), Mode=OneWay}" />
        <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource LamhaSecondaryTextStyle}"
                   Text="{x:Bind ViewModel.Next, Mode=OneWay}" Visibility="{x:Bind controls:Show.IfText(ViewModel.Next), Mode=OneWay}" />
        <Border Margin="0,4,0,0" Padding="10,3" HorizontalAlignment="Center" controls:Pill.IsPill="True" Background="{ThemeResource LamhaChipBrush}"
                Visibility="{x:Bind controls:Show.IfText(ViewModel.Streak), Mode=OneWay}">
          <TextBlock Style="{StaticResource LamhaCaptionTextStyle}" FontWeight="Bold" Foreground="{ThemeResource LamhaTextBrush}" Text="{x:Bind ViewModel.Streak, Mode=OneWay}" />
        </Border>
      </StackPanel>
    </Border>

    <!-- ===== No words yet ===== -->
    <Border Margin="0,16,0,0" Style="{StaticResource LamhaPanelStyle}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
      <StackPanel Padding="8,8,8,4" Spacing="4">
        <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource LamhaTitleTextStyle}" FontSize="16" Text="{x:Bind EmptyTitle}" />
        <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource LamhaSecondaryTextStyle}" Text="{x:Bind EmptyText}" />
      </StackPanel>
    </Border>
  </StackPanel>

  <!-- The answered card, flying off over the page while the next one comes in; left to right whatever the language,
       as the code chooses the direction -->
  <Canvas x:Name="Flying" FlowDirection="LeftToRight" IsHitTestVisible="False" />
  </Grid>
</UserControl>
