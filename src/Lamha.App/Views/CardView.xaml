<UserControl
    x:Class="Lamha.App.Views.CardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Lamha.App.Controls"
    xmlns:card="using:Lamha.App.ViewModels.Card">
  <!-- The card, as signed off in phase 1 (docs/design/card.html): the bar, the body (which scrolls past 540 px), the
       links at the foot. Sizes and gaps are the design's, on the 4 px grid; the text starts 16 px from either edge.
       Windows/CardWindow places it, sizes it to its content and draws its backdrop. -->

  <Grid x:Name="Root" KeyboardAcceleratorPlacementMode="Hidden" KeyDown="OnKeyDown">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
      <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBackKey" />
      <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="OnForwardKey" />
    </Grid.KeyboardAccelerators>
    <Grid.Resources>
      <!-- Lines of meanings: a part of speech, chips, a sense's hint, "+3" -->
      <DataTemplate x:Key="PosTemplate" x:DataType="card:PosItem">
        <TextBlock Margin="0,0,2,0" VerticalAlignment="Center" Style="{StaticResource LamhaCaptionTextStyle}"
                   FontWeight="Bold" Foreground="{ThemeResource LamhaAccentBrush}" Text="{x:Bind Label}" />
      </DataTemplate>
      <DataTemplate x:Key="ChipTemplate" x:DataType="card:ChipItem">
        <Button Style="{StaticResource LamhaChipButtonStyle}" Command="{x:Bind Open}"
                FlowDirection="{x:Bind Flow}" Content="{x:Bind Text}" FontSize="{x:Bind controls:Show.ChipSize(Small)}"
                ToolTipService.ToolTip="{x:Bind Tooltip}" AutomationProperties.Name="{x:Bind Tooltip}" />
      </DataTemplate>
      <DataTemplate x:Key="HintTemplate" x:DataType="card:HintItem">
        <TextBlock VerticalAlignment="Center" FlowDirection="LeftToRight" Style="{StaticResource LamhaCaptionTextStyle}"
                   Foreground="{ThemeResource LamhaTextFaintBrush}" Text="{x:Bind Text}" />
      </DataTemplate>
      <DataTemplate x:Key="MoreTemplate" x:DataType="card:MoreItem">
        <Button Style="{StaticResource LamhaChipButtonStyle}" Command="{x:Bind Show}" Content="{x:Bind Label}"
                FontSize="{StaticResource LamhaFontSizeCaption}" Foreground="{ThemeResource LamhaTextMutedBrush}"
                ToolTipService.ToolTip="{x:Bind Tooltip}" />
      </DataTemplate>
      <controls:MeaningTemplates x:Key="MeaningTemplates" Pos="{StaticResource PosTemplate}" Chip="{StaticResource ChipTemplate}"
                                 Hint="{StaticResource HintTemplate}" More="{StaticResource MoreTemplate}" />
      <ItemsPanelTemplate x:Key="WrapChips">
        <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="4" />
      </ItemsPanelTemplate>

      <!-- A section's heading with the line after it: "Other meanings ———" -->
      <Style x:Key="SectionHeading" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="8" />
        <Setter Property="Margin" Value="0,20,0,8" />
      </Style>
    </Grid.Resources>

    <!-- The card's solid background (Settings → Appearance → the card's background); otherwise Acrylic shows through -->
    <Border x:Name="SolidBackground" Grid.RowSpan="3" Background="{ThemeResource LamhaSurfaceBrush}" Visibility="Collapsed" />

    <!-- The hint: "Select some text first", a pill next to the mouse -->
    <Border x:Name="HintBox" Grid.RowSpan="3" x:Load="{x:Bind ViewModel.IsHint, Mode=OneWay}" Padding="16,10">
      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource LamhaBodyTextStyle}"
                 FontWeight="SemiBold" Text="{x:Bind ViewModel.HintText}" />
    </Border>

    <!-- ===== The bar: Lamha's mark and what the card shows; Back / Forward, Pin, Settings, Close ===== -->
    <Grid x:Name="Bar" Padding="16,8,10,8" ColumnSpacing="4" Background="Transparent"
          BorderBrush="{ThemeResource LamhaLineBrush}" BorderThickness="0,0,0,1"
          Visibility="{x:Bind ViewModel.HasBar, Mode=OneWay, FallbackValue=Collapsed}" PointerPressed="OnBarPressed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Lamha's mark, its name when there's room, the languages or the title, the switch, and the source -->
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Lamha}">
        <Border Width="18" Height="18" CornerRadius="5" Background="{ThemeResource LamhaBrandBrush}">
          <controls:LineIcon Glyph="Translate" Width="11" Height="11" StrokeWidth="2.6" Foreground="White" />
        </Border>
        <TextBlock VerticalAlignment="Center" Style="{StaticResource LamhaCaptionTextStyle}" FontWeight="Bold"
                   Text="{x:Bind Lamha}" Visibility="{x:Bind controls:Show.IfNot(ViewModel.HasDictSwitch), Mode=OneWay, FallbackValue=Collapsed}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
        <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Style="{StaticResource LamhaCaptionTextStyle}"
                   FontSize="{StaticResource LamhaFontSizeSectionHeading}" Foreground="{ThemeResource LamhaTextFaintBrush}"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                   Text="{x:Bind ViewModel.BarTitle, Mode=OneWay}" Visibility="{x:Bind controls:Show.IfText(ViewModel.BarTitle), Mode=OneWay, FallbackValue=Collapsed}" />
        <!-- العربية ⇄ English: the word translated, or explained in its own language -->
        <Border Margin="6,0,0,0" Padding="2" CornerRadius="{StaticResource LamhaRadiusPill}" Background="{ThemeResource LamhaChipBrush}"
                Visibility="{x:Bind ViewModel.HasDictSwitch, Mode=OneWay, FallbackValue=Collapsed}" ToolTipService.ToolTip="{x:Bind DictSwitchName}">
          <StackPanel Orientation="Horizontal" AutomationProperties.Name="{x:Bind DictSwitchName}">
            <ToggleButton Style="{StaticResource LamhaSwitchSegmentStyle}" Content="{x:Bind ViewModel.DictTranslatedLabel, Mode=OneWay}"
                          IsChecked="{x:Bind controls:Show.Not(ViewModel.DictExplained), Mode=OneWay}"
                          Command="{x:Bind ViewModel.SetDictCommand}" CommandParameter="false" />
            <ToggleButton Style="{StaticResource LamhaSwitchSegmentStyle}" Content="{x:Bind ViewModel.DictExplainedLabel, Mode=OneWay}"
                          IsChecked="{x:Bind ViewModel.DictExplained, Mode=OneWay}"
                          Command="{x:Bind ViewModel.SetDictCommand}" CommandParameter="true" />
          </StackPanel>
        </Border>
        <Border Margin="4,0,0,0" Padding="4" CornerRadius="{StaticResource LamhaRadiusPill}" Background="{ThemeResource LamhaOkSoftBrush}"
                VerticalAlignment="Center" Visibility="{x:Bind controls:Show.IfText(ViewModel.BadgeTooltip), Mode=OneWay, FallbackValue=Collapsed}"
                ToolTipService.ToolTip="{x:Bind ViewModel.BadgeTooltip, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind ViewModel.BadgeTooltip, Mode=OneWay}">
          <controls:LineIcon Glyph="{x:Bind controls:Show.BadgeGlyph(ViewModel.Badge), Mode=OneWay}" Width="12" Height="12" StrokeWidth="2.4"
                             Foreground="{ThemeResource LamhaOkBrush}" />
        </Border>
      </StackPanel>

      <!-- Back and Forward, as a pair once a word has been followed -->
      <Button x:Uid="Card_Back" Grid.Column="2" Style="{StaticResource LamhaIconButtonStyle}"
              Visibility="{x:Bind ViewModel.ShowNavigation, Mode=OneWay, FallbackValue=Collapsed}" Command="{x:Bind ViewModel.BackCommand}">
        <controls:LineIcon Glyph="Back" />
      </Button>
      <Button x:Uid="Card_Forward" Grid.Column="3" Style="{StaticResource LamhaIconButtonStyle}"
              Visibility="{x:Bind ViewModel.ShowNavigation, Mode=OneWay, FallbackValue=Collapsed}" Command="{x:Bind ViewModel.ForwardCommand}">
        <controls:LineIcon Glyph="Forward" />
      </Button>
      <Border Grid.Column="4" Width="1" Height="16" Margin="2,0" Background="{ThemeResource LamhaLineBrush}"
              Visibility="{x:Bind ViewModel.ShowNavigation, Mode=OneWay, FallbackValue=Collapsed}" />
      <ToggleButton Grid.Column="5" Style="{StaticResource LamhaIconToggleStyle}"
                    IsChecked="{x:Bind ViewModel.IsPinned, Mode=OneWay}" Command="{x:Bind ViewModel.TogglePinCommand}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.PinTooltip, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind ViewModel.PinTooltip, Mode=OneWay}">
        <controls:LineIcon Glyph="Pin" Filled="{x:Bind ViewModel.IsPinned, Mode=OneWay}" />
      </ToggleButton>
      <Button x:Uid="Card_Settings" Grid.Column="6" Style="{StaticResource LamhaIconButtonStyle}"
              Visibility="{x:Bind ViewModel.CanOpenSettings, FallbackValue=Collapsed}" Command="{x:Bind ViewModel.SettingsCommand}">
        <controls:LineIcon Glyph="Settings" />
      </Button>
      <Button x:Uid="Card_Close" Grid.Column="7" Style="{StaticResource LamhaIconButtonStyle}" Command="{x:Bind ViewModel.CloseCommand}">
        <controls:LineIcon Glyph="Close" />
      </Button>
    </Grid>

    <!-- ===== The body ===== -->
    <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                  Visibility="{x:Bind ViewModel.HasBar, Mode=OneWay, FallbackValue=Collapsed}">
      <StackPanel x:Name="Body" Padding="{StaticResource LamhaCardPadding}" SizeChanged="OnContentSizeChanged">

        <!-- Waiting: the word at once, and shapes where the answer will be -->
        <StackPanel x:Name="Waiting" x:Load="{x:Bind ViewModel.IsWaiting, Mode=OneWay}">
          <TextBlock Style="{StaticResource LamhaHeadwordTextStyle}" Text="{x:Bind ViewModel.WaitingText, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.WaitingIsWord, Mode=OneWay, FallbackValue=Collapsed}" FlowDirection="LeftToRight" TextAlignment="{x:Bind controls:Show.LatinAlignment}" />
          <TextBlock Style="{StaticResource LamhaSecondaryTextStyle}" MaxLines="3" TextTrimming="CharacterEllipsis"
                     Text="{x:Bind ViewModel.WaitingText, Mode=OneWay}" Visibility="{x:Bind controls:Show.IfNot(ViewModel.WaitingIsWord), Mode=OneWay, FallbackValue=Collapsed}" />
          <controls:Skeleton Height="52" Margin="0,12,0,0" CornerRadius="{StaticResource LamhaRadiusMedium}" />
          <StackPanel Visibility="{x:Bind ViewModel.WaitingIsWord, Mode=OneWay, FallbackValue=Collapsed}">
            <controls:Skeleton Height="12" Width="128" Margin="0,20,0,0" HorizontalAlignment="Left" CornerRadius="{StaticResource LamhaRadiusSmall}" />
            <controls:Skeleton Height="12" Margin="0,12,32,0" CornerRadius="{StaticResource LamhaRadiusSmall}" />
            <controls:Skeleton Height="12" Margin="0,8,88,0" CornerRadius="{StaticResource LamhaRadiusSmall}" />
          </StackPanel>
        </StackPanel>

        <!-- An error: what happened, what to do, one button -->
        <StackPanel x:Name="ErrorBox" x:Load="{x:Bind ViewModel.IsError, Mode=OneWay}" Padding="8,16,8,8" Spacing="4">
          <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource LamhaTitleTextStyle}"
                     Text="{x:Bind ViewModel.Error.Title, Mode=OneWay}" />
          <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource LamhaSecondaryTextStyle}"
                     Text="{x:Bind ViewModel.Error.Hint, Mode=OneWay}" />
          <Button Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource LamhaButtonStyle}"
                  Visibility="{x:Bind controls:Show.ErrorButton(ViewModel.Error), Mode=OneWay, FallbackValue=Collapsed}" Command="{x:Bind ViewModel.RunErrorActionCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <controls:LineIcon Glyph="{x:Bind controls:Show.ErrorGlyph(ViewModel.Error), Mode=OneWay}" Width="14" Height="14" />
              <TextBlock Text="{x:Bind controls:Show.ErrorLabel(ViewModel.Error), Mode=OneWay}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- The answer -->
        <StackPanel x:Name="AnswerBox" x:Load="{x:Bind ViewModel.IsAnswer, Mode=OneWay}" Opacity="{x:Bind controls:Show.Dim(ViewModel.IsBusy), Mode=OneWay}">
          <!-- 🎉 a milestone, or today's goal -->
          <Border Margin="0,0,0,12" Padding="12,8" CornerRadius="{StaticResource LamhaRadiusMedium}" Background="{ThemeResource LamhaOkSoftBrush}"
                  Visibility="{x:Bind controls:Show.IfText(ViewModel.Answer.Milestone), Mode=OneWay, FallbackValue=Collapsed}">
            <TextBlock Style="{StaticResource LamhaSecondaryTextStyle}" Foreground="{ThemeResource LamhaOkBrush}" FontWeight="SemiBold"
                       Text="{x:Bind ViewModel.Answer.Milestone, Mode=OneWay}" AutomationProperties.LiveSetting="Polite" />
          </Border>

          <!-- A word: the headword, how it sounds, what it's a form of; the bookmark -->
          <Grid ColumnSpacing="8" FlowDirection="{x:Bind ViewModel.Answer.SourceFlow, Mode=OneWay}" Visibility="{x:Bind ViewModel.Answer.IsWord, Mode=OneWay, FallbackValue=Collapsed}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource LamhaHeadwordTextStyle}" Text="{x:Bind ViewModel.Answer.Query, Mode=OneWay}" IsTextSelectionEnabled="True" />
              <TextBlock Margin="0,4,0,0" Style="{StaticResource LamhaSecondaryTextStyle}" Text="{x:Bind ViewModel.Answer.Phonetic, Mode=OneWay}"
                         Visibility="{x:Bind controls:Show.IfText(ViewModel.Answer.Phonetic), Mode=OneWay, FallbackValue=Collapsed}" />
              <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Visibility="{x:Bind controls:Show.IfText(ViewModel.Answer.FormOfText), Mode=OneWay, FallbackValue=Collapsed}">
                <TextBlock Style="{StaticResource LamhaSecondaryTextStyle}" Text="{x:Bind ViewModel.Answer.FormOfText, Mode=OneWay}" />
                <HyperlinkButton Padding="0" FontSize="{StaticResource LamhaFontSizeSecondary}" Content="{x:Bind ViewModel.Answer.FormOfWord, Mode=OneWay}"
                                 Command="{x:Bind ViewModel.Answer.OpenFormOfCommand, Mode=OneWay}"
                                 Visibility="{x:Bind controls:Show.IfText(ViewModel.Answer.FormOfWord), Mode=OneWay, FallbackValue=Collapsed}" />
              </StackPanel>
            </StackPanel>
            <ToggleButton Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource LamhaRoundToggleStyle}"
                          Visibility="{x:Bind ViewModel.Answer.CanReview, Mode=OneWay, FallbackValue=Collapsed}"
                          IsChecked="{x:Bind ViewModel.Answer.InReview, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleReviewCommand}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.Answer.ReviewTooltip, Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind ViewModel.Answer.ReviewTooltip, Mode=OneWay}">
              <controls:LineIcon Glyph="Bookmark" Width="17" Height="17" Filled="{x:Bind ViewModel.Answer.InReview, Mode=OneWay}" />
            </ToggleButton>
          </Grid>

          <!-- A text: as selected, three lines until clicked -->
          <TextBlock x:Name="SourceText" Style="{StaticResource LamhaSecondaryTextStyle}" MaxLines="3" TextTrimming="CharacterEllipsis"
                     FlowDirection="{x:Bind ViewModel.Answer.SourceFlow, Mode=OneWay}" Text="{x:Bind ViewModel.Answer.Query, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.Answer.IsText, Mode=OneWay, FallbackValue=Collapsed}" Tapped="OnSourceTapped" ToolTipService.ToolTip="{x:Bind ShowAll}" />

          <!-- Did you mean -->
          <TextBlock Margin="0,8,0,0" Style="{StaticResource LamhaSecondaryTextStyle}" Visibility="{x:Bind controls:Show.IfText(ViewModel.Answer.Spell), Mode=OneWay, FallbackValue=Collapsed}">
            <Run Text="{x:Bind DidYouMean}" /><Hyperlink Click="OnSpellClick"><Run Text="{x:Bind ViewModel.Answer.Spell, Mode=OneWay}" /></Hyperlink><Run Text="{x:Bind DidYouMeanEnd}" />
          </TextBlock>

          <!-- The hero: the meaning in this sentence, the sentence's translation around it; Copy -->
          <!-- Lamha 2's hero is right to left in both languages: the meaning on the right, Copy on the left -->
          <Border Margin="0,12,0,0" Style="{StaticResource LamhaTintedBoxStyle}" FlowDirection="RightToLeft">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Margin="0,0,0,2" Style="{StaticResource LamhaLabelTextStyle}" Foreground="{ThemeResource LamhaAccentBrush}"
                           FlowDirection="{x:Bind InterfaceFlow}" Text="{x:Bind ViewModel.Answer.HeroLabel, Mode=OneWay}" Visibility="{x:Bind controls:Show.IfText(ViewModel.Answer.HeroLabel), Mode=OneWay, FallbackValue=Collapsed}" />
                <TextBlock Style="{x:Bind controls:Show.HeroStyle(ViewModel.Answer.HeroIsLong), Mode=OneWay}" IsTextSelectionEnabled="True"
                           FlowDirection="{x:Bind ViewModel.Answer.HeroFlow, Mode=OneWay}"
                           Text="{x:Bind ViewModel.Answer.HeroText, Mode=OneWay}" Visibility="{x:Bind controls:Show.IfText(ViewModel.Answer.HeroText), Mode=OneWay, FallbackValue=Collapsed}" />
                <TextBlock Style="{StaticResource LamhaReadingTextStyle}" Foreground="{ThemeResource LamhaTextMutedBrush}" FlowDirection="{x:Bind InterfaceFlow}"
                           Visibility="{x:Bind controls:Show.IfText(ViewModel.Answer.HeroNone), Mode=OneWay, FallbackValue=Collapsed}">
                  <Run Text="{x:Bind ViewModel.Answer.HeroNone, Mode=OneWay}" />
                  <Run Text="{x:Bind ViewModel.Answer.HeroNoneGloss, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Margin="0,4,0,0" Style="{StaticResource LamhaSecondaryTextStyle}" Text="{x:Bind ViewModel.Answer.Translit, Mode=OneWay}"
                           Visibility="{x:Bind controls:Show.IfText(ViewModel.Answer.Translit), Mode=OneWay, FallbackValue=Collapsed}" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource LamhaSecondaryTextStyle}" Text="{x:Bind ViewModel.Answer.Roots, Mode=OneWay}"
                           Visibility="{x:Bind controls:Show.IfText(ViewModel.Answer.Roots), Mode=OneWay, FallbackValue=Collapsed}" />
                <!-- The sentence's translation, the word marked; or, explained, the definition's example -->
                <Border Margin="0,8,0,0" Padding="0,8,0,0" BorderBrush="{ThemeResource LamhaLineBrush}" BorderThickness="0,1,0,0"
                        Visibility="{x:Bind controls:Show.IfText(ViewModel.Answer.ContextWord), Mode=OneWay, FallbackValue=Collapsed}">
                  <TextBlock Style="{StaticResource LamhaSecondaryTextStyle}" LineHeight="23" FlowDirection="{x:Bind ViewModel.Answer.TargetFlow, Mode=OneWay}">
                    <Run Text="{x:Bind ViewModel.Answer.ContextBefore, Mode=OneWay}" /><Run Text="{x:Bind ViewModel.Answer.ContextWord, Mode=OneWay}" FontWeight="Bold" Foreground="{ThemeResource LamhaTextBrush}" /><Run Text="{x:Bind ViewModel.Answer.ContextAfter, Mode=OneWay}" />
                  </TextBlock>
                </Border>
                <Border Margin="0,8,0,0" Padding="0,8,0,0" BorderBrush="{ThemeResource LamhaLineBrush}" BorderThickness="0,1,0,0"
                        Visibility="{x:Bind controls:Show.IfText(ViewModel.Answer.HeroExample), Mode=OneWay, FallbackValue=Collapsed}">
                  <TextBlock Style="{StaticResource LamhaSecondaryTextStyle}" FlowDirection="{x:Bind ViewModel.Answer.TargetFlow, Mode=OneWay}"
                             Text="{x:Bind ViewModel.Answer.HeroExample, Mode=OneWay}" />
                </Border>
              </StackPanel>
              <Button x:Uid="Card_CopyTr" Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource LamhaIconButtonStyle}"
                      Command="{x:Bind ViewModel.CopyAnswerCommand}" Visibility="{x:Bind controls:Show.IfText(ViewModel.Answer.HeroText), Mode=OneWay, FallbackValue=Collapsed}">
                <controls:LineIcon Glyph="Copy" Width="15" Height="15" />
              </Button>
            </Grid>
          </Border>
          <TextBlock Margin="0,12,0,0" Style="{StaticResource LamhaSectionHeadingTextStyle}" Text="{x:Bind ViewModel.Answer.ExplainMissingNote, Mode=OneWay}"
                     Visibility="{x:Bind controls:Show.IfText(ViewModel.Answer.ExplainMissingNote), Mode=OneWay, FallbackValue=Collapsed}" />

          <!-- Other meanings, by part of speech -->
          <StackPanel Visibility="{x:Bind controls:Show.IfAny(ViewModel.Answer.OtherMeanings.Count), Mode=OneWay, FallbackValue=Collapsed}">
            <Grid Style="{StaticResource SectionHeading}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource LamhaSectionHeadingTextStyle}" Text="{x:Bind OtherMeaningsHeading}" />
              <Border Grid.Column="1" Height="1" VerticalAlignment="Center" Background="{ThemeResource LamhaLineBrush}" />
            </Grid>
            <ItemsControl ItemsSource="{x:Bind ViewModel.Answer.OtherMeanings, Mode=OneWay}" IsTabStop="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="card:MeaningLine">
                  <Grid Margin="{x:Bind controls:Show.TintedMargin(Best)}">
                    <Border CornerRadius="{StaticResource LamhaRadiusMedium}" Background="{ThemeResource LamhaAccentSoftBrush}" Visibility="{x:Bind Best, FallbackValue=Collapsed}" />
                    <ItemsControl Margin="{x:Bind controls:Show.TintedPadding(Best)}" ItemsSource="{x:Bind Items}" ItemTemplateSelector="{StaticResource MeaningTemplates}"
                                  ItemsPanel="{StaticResource WrapChips}" IsTabStop="False" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Definitions, by part of speech; the one that fits the sentence tinted -->
          <StackPanel Visibility="{x:Bind controls:Show.IfAny(ViewModel.Answer.Definitions.Count), Mode=OneWay, FallbackValue=Collapsed}">
            <Grid Style="{StaticResource SectionHeading}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource LamhaSectionHeadingTextStyle}" Text="{x:Bind DefinitionHeading}" />
              <Border Grid.Column="1" Height="1" VerticalAlignment="Center" Background="{ThemeResource LamhaLineBrush}" />
            </Grid>
            <ItemsControl ItemsSource="{x:Bind ViewModel.Answer.Definitions, Mode=OneWay}" IsTabStop="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="card:DefinitionGroupItem">
                  <StackPanel>
                    <TextBlock Margin="0,0,0,6" Style="{StaticResource LamhaCaptionTextStyle}" FontWeight="Bold" Foreground="{ThemeResource LamhaAccentBrush}"
                               Text="{x:Bind Pos}" Visibility="{x:Bind controls:Show.IfText(Pos), FallbackValue=Collapsed}" />
                    <ItemsControl ItemsSource="{x:Bind Entries}" IsTabStop="False">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="card:DefinitionItem">
                          <Grid Margin="{x:Bind controls:Show.DefinitionMargin(Best)}" ToolTipService.ToolTip="{x:Bind BestTooltip}">
                            <Border CornerRadius="{StaticResource LamhaRadiusMedium}" Background="{ThemeResource LamhaAccentSoftBrush}" Visibility="{x:Bind Best, FallbackValue=Collapsed}" />
                            <Grid Margin="{x:Bind controls:Show.TintedPadding(Best)}" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="18" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- The number: a small circle, the button colour on the best one -->
                            <Grid Width="18" Height="18" Margin="0,3,0,0" VerticalAlignment="Top">
                              <Ellipse Fill="{ThemeResource LamhaChipBrush}" Visibility="{x:Bind controls:Show.IfNot(Best), FallbackValue=Collapsed}" />
                              <Ellipse Fill="{ThemeResource LamhaButtonBrush}" Visibility="{x:Bind Best, FallbackValue=Collapsed}" />
                              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource LamhaFontSizeLabel}" FontWeight="Bold"
                                         Foreground="{ThemeResource LamhaTextMutedBrush}" Text="{x:Bind Number}" Visibility="{x:Bind controls:Show.IfNot(Best), FallbackValue=Collapsed}" />
                              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource LamhaFontSizeLabel}" FontWeight="Bold"
                                         Foreground="{ThemeResource LamhaButtonTextBrush}" Text="{x:Bind Number}" Visibility="{x:Bind Best, FallbackValue=Collapsed}" />
                            </Grid>
                            <StackPanel Grid.Column="1">
                              <TextBlock Style="{StaticResource LamhaTitleTextStyle}" Foreground="{ThemeResource LamhaAccentBrush}" FlowDirection="RightToLeft"
                                         TextAlignment="{x:Bind controls:Show.ArabicAlignment}"
                                         Text="{x:Bind ArabicWords}" Visibility="{x:Bind controls:Show.IfText(ArabicWords), FallbackValue=Collapsed}" />
                              <TextBlock Style="{StaticResource LamhaReadingTextStyle}" FlowDirection="RightToLeft" TextAlignment="{x:Bind controls:Show.ArabicAlignment}"
                                         Text="{x:Bind Translated, Mode=OneWay}" Visibility="{x:Bind controls:Show.IfText(Translated), Mode=OneWay, FallbackValue=Collapsed}" />
                              <controls:Skeleton Height="12" Margin="0,6,48,6" CornerRadius="{StaticResource LamhaRadiusSmall}"
                                      Visibility="{x:Bind Pending, Mode=OneWay, FallbackValue=Collapsed}" />
                              <TextBlock Margin="0,2,0,0" Style="{x:Bind controls:Show.GlossStyle(GlossIsRightToLeft)}"
                                         FlowDirection="{x:Bind controls:Show.Flow(GlossIsRightToLeft)}" TextAlignment="{x:Bind controls:Show.FlowAlignment(GlossIsRightToLeft)}"
                                         Text="{x:Bind Gloss}" IsTextSelectionEnabled="True" />
                              <Border Margin="0,4,0,0" Padding="8,0,0,0" BorderBrush="{ThemeResource LamhaLineBrush}" BorderThickness="2,0,0,0"
                                      FlowDirection="{x:Bind controls:Show.Flow(GlossIsRightToLeft)}" Visibility="{x:Bind controls:Show.IfText(Example), FallbackValue=Collapsed}">
                                <TextBlock Style="{StaticResource LamhaSecondaryTextStyle}" FontStyle="Italic" Text="{x:Bind Example}" />
                              </Border>
                              <ItemsControl Margin="0,6,0,0" ItemsSource="{x:Bind Synonyms}" ItemsPanel="{StaticResource WrapChips}" IsTabStop="False"
                                            FlowDirection="{x:Bind controls:Show.Flow(GlossIsRightToLeft)}" Visibility="{x:Bind controls:Show.IfAny(Synonyms.Count), FallbackValue=Collapsed}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="card:ChipItem">
                                    <Button Style="{StaticResource LamhaChipButtonStyle}" Padding="9,3" FontSize="{StaticResource LamhaFontSizeCaption}"
                                            Command="{x:Bind Open}" Content="{x:Bind Text}" ToolTipService.ToolTip="{x:Bind Tooltip}" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                            </Grid>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Examples, when there are no definitions -->
          <StackPanel Visibility="{x:Bind controls:Show.IfAny(ViewModel.Answer.Examples.Count), Mode=OneWay, FallbackValue=Collapsed}">
            <Grid Style="{StaticResource SectionHeading}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource LamhaSectionHeadingTextStyle}" Text="{x:Bind ExamplesHeading}" />
              <Border Grid.Column="1" Height="1" VerticalAlignment="Center" Background="{ThemeResource LamhaLineBrush}" />
            </Grid>
            <ItemsControl ItemsSource="{x:Bind ViewModel.Answer.Examples, Mode=OneWay}" IsTabStop="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Margin="0,0,0,6" Style="{StaticResource LamhaSecondaryTextStyle}" FlowDirection="LeftToRight" Text="{x:Bind}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Wikipedia -->
          <StackPanel Visibility="{x:Bind controls:Show.IfSet(ViewModel.Answer.Wikipedia), Mode=OneWay, FallbackValue=Collapsed}">
            <Grid Style="{StaticResource SectionHeading}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource LamhaSectionHeadingTextStyle}" Text="{x:Bind WikipediaHeading}" />
              <Border Grid.Column="1" Height="1" VerticalAlignment="Center" Background="{ThemeResource LamhaLineBrush}" />
            </Grid>
            <Grid ColumnSpacing="12" FlowDirection="RightToLeft">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="64" Height="64" VerticalAlignment="Top" CornerRadius="{StaticResource LamhaRadiusMedium}"
                      Visibility="{x:Bind controls:Show.IfSet(ViewModel.Answer.Wikipedia.Thumb), Mode=OneWay, FallbackValue=Collapsed}">
                <Image Stretch="UniformToFill" Source="{x:Bind controls:Show.Picture(ViewModel.Answer.Wikipedia.Thumb, 64), Mode=OneWay}" />
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Style="{StaticResource LamhaReadingTextStyle}" MaxLines="5" TextTrimming="CharacterEllipsis"
                           FlowDirection="{x:Bind ViewModel.Answer.Wikipedia.Flow, Mode=OneWay, FallbackValue=RightToLeft}"
                           Text="{x:Bind ViewModel.Answer.Wikipedia.Extract, Mode=OneWay}" IsTextSelectionEnabled="True" />
                <HyperlinkButton Margin="0,4,0,0" Padding="0" HorizontalAlignment="Left" FlowDirection="{x:Bind InterfaceFlow}" Command="{x:Bind ViewModel.Answer.Wikipedia.Read, Mode=OneWay}"
                                 Visibility="{x:Bind controls:Show.IfSet(ViewModel.Answer.Wikipedia.Url), Mode=OneWay, FallbackValue=Collapsed}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock FontSize="{StaticResource LamhaFontSizeCaption}" FontWeight="SemiBold" Foreground="{ThemeResource LamhaAccentBrush}" Text="{x:Bind ReadWiki}" />
                    <controls:LineIcon Glyph="External" Width="12" Height="12" Foreground="{ThemeResource LamhaAccentBrush}" />
                  </StackPanel>
                </HyperlinkButton>
              </StackPanel>
            </Grid>
          </StackPanel>
        </StackPanel>

        <!-- A price, in the user's currency: the price as selected, the amount, the rate and its day -->
        <StackPanel x:Name="PriceBox" x:Load="{x:Bind ViewModel.IsPrice, Mode=OneWay}">
          <TextBlock Style="{StaticResource LamhaHeadwordTextStyle}" FontFamily="{StaticResource LamhaFontFamily}" CharacterSpacing="0"
                     FlowDirection="LeftToRight" TextAlignment="{x:Bind controls:Show.LatinAlignment}"
                     Text="{x:Bind ViewModel.Price.Selected, Mode=OneWay}" IsTextSelectionEnabled="True" />
          <Border Margin="0,12,0,0" Style="{StaticResource LamhaTintedBoxStyle}">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Margin="0,0,0,2" Style="{StaticResource LamhaLabelTextStyle}" Foreground="{ThemeResource LamhaAccentBrush}"
                           Text="{x:Bind ViewModel.Price.Label, Mode=OneWay}" />
                <TextBlock Style="{StaticResource LamhaHeroTextStyle}" Text="{x:Bind ViewModel.Price.Value, Mode=OneWay}" IsTextSelectionEnabled="True" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource LamhaCaptionTextStyle}" Text="{x:Bind ViewModel.Price.RateLine, Mode=OneWay}" />
              </StackPanel>
              <Button x:Uid="Card_CopyPrice" Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource LamhaIconButtonStyle}"
                      Command="{x:Bind ViewModel.CopyAnswerCommand}">
                <controls:LineIcon Glyph="Copy" Width="15" Height="15" />
              </Button>
            </Grid>
          </Border>
        </StackPanel>

        <!-- ===== The writing tools, and Write new ===== -->
        <StackPanel x:Name="WritingBox" x:Load="{x:Bind ViewModel.IsWriting, Mode=OneWay}">
          <TextBlock x:Name="WritingSource" Style="{StaticResource LamhaSecondaryTextStyle}" MaxLines="2" TextTrimming="CharacterEllipsis"
                     FlowDirection="{x:Bind ViewModel.Writing.SourceFlow, Mode=OneWay}" Text="{x:Bind ViewModel.Writing.Source, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.Writing.HasSource, Mode=OneWay, FallbackValue=Collapsed}" Tapped="OnSourceTapped" ToolTipService.ToolTip="{x:Bind ShowAll}" />
          <ItemsControl Margin="0,12,0,0" ItemsSource="{x:Bind ViewModel.Writing.Tools, Mode=OneWay}" IsTabStop="False"
                        Visibility="{x:Bind ViewModel.Writing.HasTools, Mode=OneWay, FallbackValue=Collapsed}" AutomationProperties.Name="{x:Bind WritingToolsName}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="card:ToolChip">
                <ToggleButton Style="{StaticResource LamhaChipStyle}" IsChecked="{x:Bind IsOn, Mode=TwoWay}" Command="{x:Bind Pick}"
                              IsEnabled="True" ToolTipService.ToolTip="{x:Bind Tooltip}" AutomationProperties.AcceleratorKey="{x:Bind Keys}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock FontSize="{StaticResource LamhaFontSizeLabel}" FontWeight="Bold" Opacity="0.65" VerticalAlignment="Center" Text="{x:Bind Number}" />
                    <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" />
                  </StackPanel>
                </ToggleButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Margin="{x:Bind controls:Show.WritingOutMargin(ViewModel.Writing.IsCompose), Mode=OneWay}">
            <!-- Working -->
            <StackPanel Visibility="{x:Bind ViewModel.Writing.IsWorking, Mode=OneWay, FallbackValue=Collapsed}" Spacing="8">
              <controls:Skeleton Height="14" Margin="0,0,24,0" CornerRadius="{StaticResource LamhaRadiusSmall}" />
              <controls:Skeleton Height="14" Margin="0,0,80,0" CornerRadius="{StaticResource LamhaRadiusSmall}" />
              <controls:Skeleton Height="14" Margin="0,0,160,0" CornerRadius="{StaticResource LamhaRadiusSmall}" />
            </StackPanel>

            <!-- A result, with Replace (or Insert), Copy, the other language or the request, and Try again -->
            <StackPanel Visibility="{x:Bind ViewModel.Writing.IsResult, Mode=OneWay, FallbackValue=Collapsed}">
              <Border Padding="16,12" CornerRadius="{StaticResource LamhaRadiusMedium}" Background="{ThemeResource LamhaAccentSoftBrush}">
                <controls:DiffText FlowDirection="{x:Bind ViewModel.Writing.ResultFlow, Mode=OneWay}" TextStyle="{StaticResource LamhaReadingTextStyle}"
                                   Parts="{x:Bind ViewModel.Writing.Diff, Mode=OneWay}" Fallback="{x:Bind ViewModel.Writing.Result, Mode=OneWay}" />
              </Border>
              <Grid Margin="0,8,0,0" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource LamhaButtonStyle}" Command="{x:Bind ViewModel.Writing.ReplaceCommand, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Writing.CanReplaceResult, Mode=OneWay, FallbackValue=Collapsed}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <controls:LineIcon Glyph="Check" Width="14" Height="14" />
                    <TextBlock Text="{x:Bind ViewModel.Writing.ReplaceLabel, Mode=OneWay}" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="1" Style="{x:Bind controls:Show.CopyStyle(ViewModel.Writing.CanReplaceResult), Mode=OneWay}"
                        Command="{x:Bind ViewModel.Writing.CopyCommand, Mode=OneWay}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <controls:LineIcon Glyph="Copy" Width="14" Height="14" />
                    <TextBlock Text="{x:Bind CopyLabel}" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource LamhaQuietButtonStyle}" Content="{x:Bind ViewModel.Writing.SecondaryLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.Writing.SecondaryCommand, Mode=OneWay}" Visibility="{x:Bind controls:Show.IfText(ViewModel.Writing.SecondaryLabel), Mode=OneWay, FallbackValue=Collapsed}" />
                <Button x:Uid="Card_Again" Grid.Column="4" Style="{StaticResource LamhaIconButtonStyle}" Command="{x:Bind ViewModel.Writing.AgainCommand, Mode=OneWay}">
                  <controls:LineIcon Glyph="Retry" Width="15" Height="15" />
                </Button>
              </Grid>

              <!-- Proofreading: each correction, its kind, and why -->
              <StackPanel Visibility="{x:Bind ViewModel.Writing.IsProofread, Mode=OneWay, FallbackValue=Collapsed}">
                <Grid Style="{StaticResource SectionHeading}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource LamhaSectionHeadingTextStyle}" Text="{x:Bind ViewModel.Writing.CorrectionsTitle, Mode=OneWay}" />
                  <Border Grid.Column="1" Height="1" VerticalAlignment="Center" Background="{ThemeResource LamhaLineBrush}" />
                </Grid>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Writing.Issues, Mode=OneWay}" IsTabStop="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="card:IssueItem">
                      <StackPanel Padding="0,8" BorderBrush="{ThemeResource LamhaLineBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Style="{StaticResource LamhaBodyTextStyle}" FlowDirection="LeftToRight" TextAlignment="{x:Bind controls:Show.LatinAlignment}">
                          <Run Text="{x:Bind Original}" Foreground="{ThemeResource LamhaDangerBrush}" TextDecorations="Strikethrough" /><Run Text=" → " /><Run Text="{x:Bind Fix}" Foreground="{ThemeResource LamhaOkBrush}" FontWeight="SemiBold" />
                        </TextBlock>
                        <Border Margin="0,4,0,0" Padding="8,1" HorizontalAlignment="Left" CornerRadius="{StaticResource LamhaRadiusPill}"
                                Background="{ThemeResource LamhaAccentSoftBrush}" Visibility="{x:Bind HasCategory, FallbackValue=Collapsed}">
                          <TextBlock Style="{StaticResource LamhaLabelTextStyle}" Foreground="{ThemeResource LamhaAccentBrush}" Text="{x:Bind Category}" />
                        </Border>
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource LamhaSecondaryTextStyle}" FlowDirection="{x:Bind WhyFlow}" Text="{x:Bind Why}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>

            <!-- No mistakes -->
            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.Writing.IsNoMistakes, Mode=OneWay, FallbackValue=Collapsed}">
              <controls:LineIcon Glyph="Check" StrokeWidth="2.6" Foreground="{ThemeResource LamhaOkBrush}" />
              <TextBlock Style="{StaticResource LamhaBodyTextStyle}" FontWeight="SemiBold" Foreground="{ThemeResource LamhaOkBrush}" Text="{x:Bind NoMistakes}" />
            </StackPanel>

            <!-- An error (not set up yet, the key, the quota…) -->
            <StackPanel Padding="8,16,8,8" Spacing="4" Visibility="{x:Bind ViewModel.Writing.IsError, Mode=OneWay, FallbackValue=Collapsed}">
              <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource LamhaTitleTextStyle}" Text="{x:Bind ViewModel.Writing.Error.Title, Mode=OneWay}" />
              <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource LamhaSecondaryTextStyle}" Text="{x:Bind ViewModel.Writing.Error.Hint, Mode=OneWay}" />
              <Button Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource LamhaButtonStyle}"
                      Visibility="{x:Bind controls:Show.ErrorButton(ViewModel.Writing.Error), Mode=OneWay, FallbackValue=Collapsed}" Command="{x:Bind ViewModel.Writing.RunErrorActionCommand, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <controls:LineIcon Glyph="{x:Bind controls:Show.ErrorGlyph(ViewModel.Writing.Error), Mode=OneWay}" Width="14" Height="14" />
                  <TextBlock Text="{x:Bind controls:Show.ErrorLabel(ViewModel.Writing.Error), Mode=OneWay}" />
                </StackPanel>
              </Button>
            </StackPanel>

            <!-- Reply's and Write new's request: what to write, its kind, its tone -->
            <StackPanel Visibility="{x:Bind ViewModel.Writing.IsForm, Mode=OneWay, FallbackValue=Collapsed}">
              <TextBox x:Name="IntentBox" MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap" TextReadingOrder="DetectFromContent"
                       PlaceholderText="{x:Bind ViewModel.Writing.IntentPlaceholder, Mode=OneWay}"
                       Text="{x:Bind ViewModel.Writing.Intent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="{x:Bind ComposeLabel}">
                <TextBox.KeyboardAccelerators>
                  <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="OnWriteKey" />
                </TextBox.KeyboardAccelerators>
              </TextBox>
              <StackPanel Visibility="{x:Bind ViewModel.Writing.ShowKinds, Mode=OneWay, FallbackValue=Collapsed}">
                <TextBlock Margin="0,12,0,0" Style="{StaticResource LamhaSectionHeadingTextStyle}" Text="{x:Bind KindHeading}" />
                <ItemsControl Margin="0,6,0,0" ItemsSource="{x:Bind ViewModel.Writing.Kinds, Mode=OneWay}" ItemsPanel="{StaticResource WrapChips}" IsTabStop="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="card:ChoiceChip">
                      <ToggleButton Style="{StaticResource LamhaChipStyle}" IsChecked="{x:Bind IsOn, Mode=TwoWay}" Content="{x:Bind Label}" Click="OnChoice" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <TextBlock Margin="0,12,0,0" Style="{StaticResource LamhaSectionHeadingTextStyle}" Text="{x:Bind ToneHeading}" />
              <ItemsControl Margin="0,6,0,0" ItemsSource="{x:Bind ViewModel.Writing.Tones, Mode=OneWay}" ItemsPanel="{StaticResource WrapChips}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="card:ChoiceChip">
                    <ToggleButton Style="{StaticResource LamhaChipStyle}" IsChecked="{x:Bind IsOn, Mode=TwoWay}" Content="{x:Bind Label}" Click="OnChoice" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Margin="0,12,0,0" HorizontalAlignment="Left" Style="{StaticResource LamhaButtonStyle}" Command="{x:Bind ViewModel.Writing.GoCommand, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <controls:LineIcon Glyph="Sparkle" Width="14" Height="14" />
                  <TextBlock Text="{x:Bind ViewModel.Writing.GoLabel, Mode=OneWay}" />
                  <TextBlock Margin="4,0,0,0" FontSize="{StaticResource LamhaFontSizeLabel}" FontWeight="Normal" Opacity="0.75" VerticalAlignment="Center" Text="Ctrl+Enter" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- ===== The links at the foot ===== -->
    <Border x:Name="Foot" Grid.Row="2" Padding="8,6" BorderBrush="{ThemeResource LamhaLineBrush}" BorderThickness="0,1,0,0"
            Visibility="{x:Bind controls:Show.IfAny(ViewModel.Links.Count), Mode=OneWay, FallbackValue=Collapsed}" SizeChanged="OnContentSizeChanged">
      <ItemsControl ItemsSource="{x:Bind ViewModel.Links, Mode=OneWay}" IsTabStop="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <controls:WrapPanel HorizontalSpacing="4" VerticalSpacing="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="card:LinkItem">
            <Button Style="{StaticResource LamhaFootLinkStyle}" Command="{x:Bind Open}" ToolTipService.ToolTip="{x:Bind controls:Show.Tooltip(Tooltip)}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <controls:LineIcon Glyph="{x:Bind Glyph}" Width="13" Height="13" />
                <TextBlock Text="{x:Bind Label}" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- "Copied", "Added to review": a moment at the foot of the card -->
    <Border Grid.Row="1" Grid.RowSpan="2" Margin="0,0,0,12" Padding="12,6" HorizontalAlignment="Center" VerticalAlignment="Bottom"
            CornerRadius="{StaticResource LamhaRadiusPill}" Background="{ThemeResource LamhaToastBackgroundBrush}"
            Visibility="{x:Bind controls:Show.IfText(ViewModel.Toast), Mode=OneWay, FallbackValue=Collapsed}" IsHitTestVisible="False">
      <TextBlock FontSize="{StaticResource LamhaFontSizeSecondary}" FontWeight="SemiBold" Foreground="{ThemeResource LamhaToastTextBrush}" Text="{x:Bind ViewModel.Toast, Mode=OneWay}" />
    </Border>
  </Grid>
</UserControl>
