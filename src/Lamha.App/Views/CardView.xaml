<UserControl
    x:Class="Lamha.App.Views.CardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Lamha.App.Controls"
    xmlns:card="using:Lamha.App.ViewModels.Card"
    xmlns:views="using:Lamha.App.Views">
  <!-- The card, as signed off in phase 1 (docs/design/card.html): the bar, the body (which scrolls past 540 px), the
       links at the foot. Sizes and gaps are the design's, on the 4 px grid; the text starts 16 px from either edge.
       Windows/CardWindow places it, sizes it to its content and draws its backdrop. -->

  <Grid x:Name="Root" KeyboardAcceleratorPlacementMode="Hidden" KeyDown="OnKeyDown">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
      <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBackKey" />
      <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="OnForwardKey" />
    </Grid.KeyboardAccelerators>
    <!-- The card's solid background (Settings → Appearance → the card's background); otherwise Acrylic shows through -->
    <Border x:Name="SolidBackground" Grid.RowSpan="3" Background="{ThemeResource LamhaSurfaceBrush}" Visibility="Collapsed" />

    <!-- The hint: "Select some text first", a pill next to the mouse -->
    <Border x:Name="HintBox" Grid.RowSpan="3" x:Load="{x:Bind ViewModel.IsHint, Mode=OneWay}" Padding="16,10">
      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource LamhaBodyTextStyle}"
                 FontWeight="SemiBold" Text="{x:Bind ViewModel.HintText}" />
    </Border>

    <!-- ===== The bar: Lamha's mark and what the card shows; Back / Forward, Pin, Settings, Close ===== -->
    <Grid x:Name="Bar" Padding="16,8,10,8" ColumnSpacing="4" Background="Transparent"
          BorderBrush="{ThemeResource LamhaLineBrush}" BorderThickness="0,0,0,1"
          Visibility="{x:Bind ViewModel.HasBar, Mode=OneWay, FallbackValue=Collapsed}" PointerPressed="OnBarPressed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Lamha's mark, its name when there's room, the languages or the title, the switch, and the source -->
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Lamha}">
        <controls:BrandMark />
        <TextBlock VerticalAlignment="Center" Style="{StaticResource LamhaCaptionTextStyle}" FontWeight="Bold"
                   Text="{x:Bind Lamha}" Visibility="{x:Bind controls:Show.IfNot(ViewModel.HasDictSwitch), Mode=OneWay, FallbackValue=Collapsed}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
        <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Style="{StaticResource LamhaCaptionTextStyle}"
                   FontSize="{StaticResource LamhaFontSizeBody}" Foreground="{ThemeResource LamhaTextFaintBrush}"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                   Text="{x:Bind ViewModel.BarTitle, Mode=OneWay}" Visibility="{x:Bind controls:Show.IfText(ViewModel.BarTitle), Mode=OneWay, FallbackValue=Collapsed}" />
        <!-- العربية ⇄ English: the word translated, or explained in its own language -->
        <Border Margin="6,0,0,0" Padding="2" controls:Pill.IsPill="True" Background="{ThemeResource LamhaChipBrush}"
                Visibility="{x:Bind ViewModel.HasDictSwitch, Mode=OneWay, FallbackValue=Collapsed}" ToolTipService.ToolTip="{x:Bind DictSwitchName}">
          <StackPanel Orientation="Horizontal" AutomationProperties.Name="{x:Bind DictSwitchName}">
            <ToggleButton Style="{StaticResource LamhaSwitchSegmentStyle}" Content="{x:Bind ViewModel.DictTranslatedLabel, Mode=OneWay}"
                          IsChecked="{x:Bind controls:Show.Not(ViewModel.DictExplained), Mode=OneWay}"
                          Command="{x:Bind ViewModel.SetDictCommand}" CommandParameter="false" />
            <ToggleButton Style="{StaticResource LamhaSwitchSegmentStyle}" Content="{x:Bind ViewModel.DictExplainedLabel, Mode=OneWay}"
                          IsChecked="{x:Bind ViewModel.DictExplained, Mode=OneWay}"
                          Command="{x:Bind ViewModel.SetDictCommand}" CommandParameter="true" />
          </StackPanel>
        </Border>
        <!-- Where the answer came from (the dictionary, or AI): Windows' icon in the secondary colour, said by its tooltip
             (the study's C2) -->
        <Border Margin="4,0,0,0" Padding="4" Background="Transparent"
                VerticalAlignment="Center" Visibility="{x:Bind controls:Show.IfText(ViewModel.BadgeTooltip), Mode=OneWay, FallbackValue=Collapsed}"
                ToolTipService.ToolTip="{x:Bind ViewModel.BadgeTooltip, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind ViewModel.BadgeTooltip, Mode=OneWay}">
          <controls:FluentIcon Glyph="{x:Bind controls:Show.BadgeGlyph(ViewModel.Badge), Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Border>
      </StackPanel>

      <!-- Back and Forward, as a pair once a word has been followed -->
      <Button x:Uid="Card_Back" Grid.Column="2" Style="{StaticResource LamhaIconButtonStyle}"
              Visibility="{x:Bind ViewModel.ShowNavigation, Mode=OneWay, FallbackValue=Collapsed}" Command="{x:Bind ViewModel.BackCommand}">
        <controls:FluentIcon Glyph="Back" />
      </Button>
      <Button x:Uid="Card_Forward" Grid.Column="3" Style="{StaticResource LamhaIconButtonStyle}"
              Visibility="{x:Bind ViewModel.ShowNavigation, Mode=OneWay, FallbackValue=Collapsed}" Command="{x:Bind ViewModel.ForwardCommand}">
        <controls:FluentIcon Glyph="Forward" />
      </Button>
      <Border Grid.Column="4" Width="1" Height="16" Margin="2,0" Background="{ThemeResource LamhaLineBrush}"
              Visibility="{x:Bind ViewModel.ShowNavigation, Mode=OneWay, FallbackValue=Collapsed}" />
      <ToggleButton Grid.Column="5" Style="{StaticResource LamhaIconToggleStyle}"
                    IsChecked="{x:Bind ViewModel.IsPinned, Mode=OneWay}" Command="{x:Bind ViewModel.TogglePinCommand}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.PinTooltip, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind ViewModel.PinTooltip, Mode=OneWay}">
        <controls:FluentIcon Glyph="Pin" Filled="{x:Bind ViewModel.IsPinned, Mode=OneWay}" />
      </ToggleButton>
      <Button x:Uid="Card_Settings" Grid.Column="6" Style="{StaticResource LamhaIconButtonStyle}"
              Visibility="{x:Bind ViewModel.CanOpenSettings, FallbackValue=Collapsed}" Command="{x:Bind ViewModel.SettingsCommand}">
        <controls:FluentIcon Glyph="Settings" />
      </Button>
      <Button x:Uid="Card_Close" Grid.Column="7" Style="{StaticResource LamhaIconButtonStyle}" Command="{x:Bind ViewModel.CloseCommand}">
        <controls:FluentIcon Glyph="Close" />
      </Button>
    </Grid>

    <!-- ===== The body ===== -->
    <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                  Visibility="{x:Bind ViewModel.HasBar, Mode=OneWay, FallbackValue=Collapsed}">
      <StackPanel x:Name="Body" Padding="{StaticResource LamhaCardPadding}" SizeChanged="OnContentSizeChanged">

        <!-- Waiting: the word at once, and shapes where the answer will be -->
        <StackPanel x:Name="Waiting" x:Load="{x:Bind ViewModel.IsWaiting, Mode=OneWay}">
          <TextBlock Style="{StaticResource LamhaHeadwordTextStyle}" Text="{x:Bind ViewModel.WaitingText, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.WaitingIsWord, Mode=OneWay, FallbackValue=Collapsed}" FlowDirection="LeftToRight" TextAlignment="{x:Bind controls:Show.LatinAlignment}" />
          <TextBlock Style="{StaticResource LamhaSecondaryTextStyle}" MaxLines="3" TextTrimming="CharacterEllipsis"
                     Text="{x:Bind ViewModel.WaitingText, Mode=OneWay}" Visibility="{x:Bind controls:Show.IfNot(ViewModel.WaitingIsWord), Mode=OneWay, FallbackValue=Collapsed}" />
          <controls:Skeleton Height="52" Margin="0,12,0,0" CornerRadius="{StaticResource LamhaRadiusControl}" />
          <StackPanel Visibility="{x:Bind ViewModel.WaitingIsWord, Mode=OneWay, FallbackValue=Collapsed}">
            <controls:Skeleton Height="12" Width="128" Margin="0,20,0,0" HorizontalAlignment="Left" CornerRadius="{StaticResource LamhaRadiusControl}" />
            <controls:Skeleton Height="12" Margin="0,12,32,0" CornerRadius="{StaticResource LamhaRadiusControl}" />
            <controls:Skeleton Height="12" Margin="0,8,88,0" CornerRadius="{StaticResource LamhaRadiusControl}" />
          </StackPanel>
        </StackPanel>

        <!-- An error: what happened, what to do, one button -->
        <StackPanel x:Name="ErrorBox" x:Load="{x:Bind ViewModel.IsError, Mode=OneWay}" Padding="8,16,8,8" Spacing="4">
          <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource LamhaTitleTextStyle}"
                     Text="{x:Bind ViewModel.Error.Title, Mode=OneWay}" />
          <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource LamhaSecondaryTextStyle}"
                     Text="{x:Bind ViewModel.Error.Hint, Mode=OneWay}" />
          <Button Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource LamhaButtonStyle}"
                  Visibility="{x:Bind controls:Show.ErrorButton(ViewModel.Error), Mode=OneWay, FallbackValue=Collapsed}" Command="{x:Bind ViewModel.RunErrorActionCommand}"
                  AutomationProperties.Name="{x:Bind controls:Show.ErrorLabel(ViewModel.Error), Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <controls:FluentIcon Glyph="{x:Bind controls:Show.ErrorGlyph(ViewModel.Error), Mode=OneWay}" />
              <TextBlock Text="{x:Bind controls:Show.ErrorLabel(ViewModel.Error), Mode=OneWay}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- The answer -->
        <views:AnswerView x:Name="AnswerBox" x:Load="{x:Bind ViewModel.IsAnswer, Mode=OneWay}" Answer="{x:Bind ViewModel.Answer, Mode=OneWay}"
                          Opacity="{x:Bind controls:Show.Dim(ViewModel.IsBusy), Mode=OneWay}" />

        <!-- A price, in the user's currency: the price as selected, the amount, the rate and its day -->
        <views:PriceView x:Name="PriceBox" x:Load="{x:Bind ViewModel.IsPrice, Mode=OneWay}" Price="{x:Bind ViewModel.Price, Mode=OneWay}" />

        <!-- ===== The writing tools, and Write new ===== -->
        <StackPanel x:Name="WritingBox" x:Load="{x:Bind ViewModel.IsWriting, Mode=OneWay}">
          <TextBlock x:Name="WritingSource" Style="{StaticResource LamhaSecondaryTextStyle}" MaxLines="2" TextTrimming="CharacterEllipsis"
                     FlowDirection="{x:Bind ViewModel.Writing.SourceFlow, Mode=OneWay}" Text="{x:Bind ViewModel.Writing.Source, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.Writing.HasSource, Mode=OneWay, FallbackValue=Collapsed}" Tapped="OnSourceTapped" ToolTipService.ToolTip="{x:Bind ShowAll}" />
          <ItemsControl Margin="0,12,0,0" ItemsSource="{x:Bind ViewModel.Writing.Tools, Mode=OneWay}" IsTabStop="False"
                        Visibility="{x:Bind ViewModel.Writing.HasTools, Mode=OneWay, FallbackValue=Collapsed}" AutomationProperties.Name="{x:Bind WritingToolsName}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="card:ToolChip">
                <ToggleButton Style="{StaticResource LamhaChipStyle}" IsChecked="{x:Bind IsOn, Mode=TwoWay}" Command="{x:Bind Pick}"
                              IsEnabled="True" ToolTipService.ToolTip="{x:Bind Tooltip}" AutomationProperties.AcceleratorKey="{x:Bind Keys}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock FontSize="{StaticResource LamhaFontSizeCaption}" FontWeight="Bold" Opacity="0.65" VerticalAlignment="Center" Text="{x:Bind Number}" />
                    <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" />
                  </StackPanel>
                </ToggleButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Margin="{x:Bind controls:Show.WritingOutMargin(ViewModel.Writing.IsCompose), Mode=OneWay}">
            <!-- Working -->
            <StackPanel Visibility="{x:Bind ViewModel.Writing.IsWorking, Mode=OneWay, FallbackValue=Collapsed}" Spacing="8">
              <controls:Skeleton Height="14" Margin="0,0,24,0" CornerRadius="{StaticResource LamhaRadiusControl}" />
              <controls:Skeleton Height="14" Margin="0,0,80,0" CornerRadius="{StaticResource LamhaRadiusControl}" />
              <controls:Skeleton Height="14" Margin="0,0,160,0" CornerRadius="{StaticResource LamhaRadiusControl}" />
            </StackPanel>

            <!-- A result, with Replace (or Insert), Copy, the other language or the request, and Try again -->
            <StackPanel Visibility="{x:Bind ViewModel.Writing.IsResult, Mode=OneWay, FallbackValue=Collapsed}">
              <Border Padding="16,12" CornerRadius="{StaticResource LamhaRadiusControl}" Background="{ThemeResource LamhaAccentSoftBrush}">
                <controls:DiffText FlowDirection="{x:Bind ViewModel.Writing.ResultFlow, Mode=OneWay}" TextStyle="{StaticResource LamhaReadingTextStyle}"
                                   Parts="{x:Bind ViewModel.Writing.Diff, Mode=OneWay}" Fallback="{x:Bind ViewModel.Writing.Result, Mode=OneWay}" />
              </Border>
              <Grid Margin="0,8,0,0" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource LamhaButtonStyle}" Command="{x:Bind ViewModel.Writing.ReplaceCommand, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Writing.CanReplaceResult, Mode=OneWay, FallbackValue=Collapsed}"
                        AutomationProperties.Name="{x:Bind ViewModel.Writing.ReplaceLabel, Mode=OneWay}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <controls:FluentIcon Glyph="Check" />
                    <TextBlock Text="{x:Bind ViewModel.Writing.ReplaceLabel, Mode=OneWay}" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="1" Style="{x:Bind controls:Show.CopyStyle(ViewModel.Writing.CanReplaceResult), Mode=OneWay}"
                        Command="{x:Bind ViewModel.Writing.CopyCommand, Mode=OneWay}" AutomationProperties.Name="{x:Bind CopyLabel}" controls:Feedback.Copy="True">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <controls:FluentIcon Glyph="Copy" />
                    <TextBlock Text="{x:Bind CopyLabel}" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource LamhaQuietButtonStyle}" Content="{x:Bind ViewModel.Writing.SecondaryLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.Writing.SecondaryCommand, Mode=OneWay}" Visibility="{x:Bind controls:Show.IfText(ViewModel.Writing.SecondaryLabel), Mode=OneWay, FallbackValue=Collapsed}" />
                <Button x:Uid="Card_Again" Grid.Column="4" Style="{StaticResource LamhaIconButtonStyle}" Command="{x:Bind ViewModel.Writing.AgainCommand, Mode=OneWay}">
                  <controls:FluentIcon Glyph="Retry" />
                </Button>
              </Grid>

              <!-- Proofreading: each correction, its kind, and why -->
              <StackPanel Visibility="{x:Bind ViewModel.Writing.IsProofread, Mode=OneWay, FallbackValue=Collapsed}">
                <Grid Style="{StaticResource LamhaSectionRowStyle}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource LamhaSectionHeadingTextStyle}" Text="{x:Bind ViewModel.Writing.CorrectionsTitle, Mode=OneWay}" />
                  <Border Grid.Column="1" Height="1" VerticalAlignment="Center" Background="{ThemeResource LamhaLineBrush}" />
                </Grid>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Writing.Issues, Mode=OneWay}" IsTabStop="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="card:IssueItem">
                      <StackPanel Padding="0,8" BorderBrush="{ThemeResource LamhaLineBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Style="{StaticResource LamhaBodyTextStyle}" FlowDirection="LeftToRight" TextAlignment="{x:Bind controls:Show.LatinAlignment}">
                          <Run Text="{x:Bind Original}" Foreground="{ThemeResource LamhaDangerBrush}" TextDecorations="Strikethrough" /><Run Text=" → " /><Run Text="{x:Bind Fix}" Foreground="{ThemeResource LamhaOkBrush}" FontWeight="SemiBold" />
                        </TextBlock>
                        <Border Margin="0,4,0,0" Padding="8,1" HorizontalAlignment="Left" controls:Pill.IsPill="True"
                                Background="{ThemeResource LamhaAccentSoftBrush}" Visibility="{x:Bind HasCategory, FallbackValue=Collapsed}">
                          <TextBlock Style="{StaticResource LamhaLabelTextStyle}" Foreground="{ThemeResource LamhaAccentBrush}" Text="{x:Bind Category}" />
                        </Border>
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource LamhaSecondaryTextStyle}" FlowDirection="{x:Bind WhyFlow}" Text="{x:Bind Why}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>

            <!-- No mistakes -->
            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.Writing.IsNoMistakes, Mode=OneWay, FallbackValue=Collapsed}">
              <controls:FluentIcon Glyph="Check" Foreground="{ThemeResource LamhaOkBrush}" />
              <TextBlock Style="{StaticResource LamhaBodyTextStyle}" FontWeight="SemiBold" Foreground="{ThemeResource LamhaOkBrush}" Text="{x:Bind NoMistakes}" />
            </StackPanel>

            <!-- An error (not set up yet, the key, the quota…) -->
            <StackPanel Padding="8,16,8,8" Spacing="4" Visibility="{x:Bind ViewModel.Writing.IsError, Mode=OneWay, FallbackValue=Collapsed}">
              <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource LamhaTitleTextStyle}" Text="{x:Bind ViewModel.Writing.Error.Title, Mode=OneWay}" />
              <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource LamhaSecondaryTextStyle}" Text="{x:Bind ViewModel.Writing.Error.Hint, Mode=OneWay}" />
              <Button Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource LamhaButtonStyle}"
                      Visibility="{x:Bind controls:Show.ErrorButton(ViewModel.Writing.Error), Mode=OneWay, FallbackValue=Collapsed}" Command="{x:Bind ViewModel.Writing.RunErrorActionCommand, Mode=OneWay}"
                      AutomationProperties.Name="{x:Bind controls:Show.ErrorLabel(ViewModel.Writing.Error), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <controls:FluentIcon Glyph="{x:Bind controls:Show.ErrorGlyph(ViewModel.Writing.Error), Mode=OneWay}" />
                  <TextBlock Text="{x:Bind controls:Show.ErrorLabel(ViewModel.Writing.Error), Mode=OneWay}" />
                </StackPanel>
              </Button>
            </StackPanel>

            <!-- Reply's and Write new's request: what to write, its kind, its tone -->
            <StackPanel Visibility="{x:Bind ViewModel.Writing.IsForm, Mode=OneWay, FallbackValue=Collapsed}">
              <TextBox x:Name="IntentBox" MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap" TextReadingOrder="DetectFromContent"
                       PlaceholderText="{x:Bind ViewModel.Writing.IntentPlaceholder, Mode=OneWay}"
                       Text="{x:Bind ViewModel.Writing.Intent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="{x:Bind ComposeLabel}">
                <TextBox.KeyboardAccelerators>
                  <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="OnWriteKey" />
                </TextBox.KeyboardAccelerators>
              </TextBox>
              <StackPanel Visibility="{x:Bind ViewModel.Writing.ShowKinds, Mode=OneWay, FallbackValue=Collapsed}">
                <TextBlock Margin="0,12,0,0" Style="{StaticResource LamhaSectionHeadingTextStyle}" Text="{x:Bind KindHeading}" />
                <ItemsControl Margin="0,6,0,0" ItemsSource="{x:Bind ViewModel.Writing.Kinds, Mode=OneWay}" ItemsPanel="{StaticResource LamhaWrapChipsPanel}" IsTabStop="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="card:ChoiceChip">
                      <ToggleButton Style="{StaticResource LamhaChipStyle}" IsChecked="{x:Bind IsOn, Mode=TwoWay}" Content="{x:Bind Label}" Click="OnChoice" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <TextBlock Margin="0,12,0,0" Style="{StaticResource LamhaSectionHeadingTextStyle}" Text="{x:Bind ToneHeading}" />
              <ItemsControl Margin="0,6,0,0" ItemsSource="{x:Bind ViewModel.Writing.Tones, Mode=OneWay}" ItemsPanel="{StaticResource LamhaWrapChipsPanel}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="card:ChoiceChip">
                    <ToggleButton Style="{StaticResource LamhaChipStyle}" IsChecked="{x:Bind IsOn, Mode=TwoWay}" Content="{x:Bind Label}" Click="OnChoice" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Margin="0,12,0,0" HorizontalAlignment="Left" Style="{StaticResource LamhaButtonStyle}" Command="{x:Bind ViewModel.Writing.GoCommand, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <controls:FluentIcon Glyph="Sparkle" />
                  <TextBlock Text="{x:Bind ViewModel.Writing.GoLabel, Mode=OneWay}" />
                  <TextBlock Margin="4,0,0,0" FontSize="{StaticResource LamhaFontSizeCaption}" FontWeight="Normal" Opacity="0.75" VerticalAlignment="Center" Text="Ctrl+Enter" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- ===== The links at the foot ===== -->
    <Border x:Name="Foot" Grid.Row="2" Padding="8,6" BorderBrush="{ThemeResource LamhaLineBrush}" BorderThickness="0,1,0,0"
            Visibility="{x:Bind controls:Show.IfAny(ViewModel.Links.Count), Mode=OneWay, FallbackValue=Collapsed}" SizeChanged="OnContentSizeChanged">
      <ItemsControl ItemsSource="{x:Bind ViewModel.Links, Mode=OneWay}" IsTabStop="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <controls:WrapPanel HorizontalSpacing="4" VerticalSpacing="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="card:LinkItem">
            <HyperlinkButton Style="{StaticResource LamhaFootLinkStyle}" Command="{x:Bind Open}" ToolTipService.ToolTip="{x:Bind controls:Show.Tooltip(Tooltip)}"
                             AutomationProperties.Name="{x:Bind Label}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource LamhaSpace1}">
                <controls:FluentIcon Glyph="{x:Bind Glyph}" Size="Small" />
                <TextBlock Text="{x:Bind Label}" />
              </StackPanel>
            </HyperlinkButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- "Copied", "Added to review": a moment at the foot of the card -->
    <Border Grid.Row="1" Grid.RowSpan="2" Margin="0,0,0,12" Style="{StaticResource LamhaToastStyle}"
            Visibility="{x:Bind controls:Show.IfText(ViewModel.Toast), Mode=OneWay, FallbackValue=Collapsed}" IsHitTestVisible="False">
      <TextBlock Style="{StaticResource LamhaToastTextStyle}" Text="{x:Bind ViewModel.Toast, Mode=OneWay}" />
    </Border>
  </Grid>
</UserControl>
