<Project Sdk="Microsoft.NET.Sdk">
  <!-- Win32 and UI Automation: everything Lamha does with other programs and with Windows itself.
       No WinUI here, so it's tested without a window. Bindings are generated by CsWin32 from NativeMethods.txt. -->

  <PropertyGroup>
    <TargetFramework>$(LamhaWindowsTarget)</TargetFramework>
    <SupportedOSPlatformVersion>$(LamhaWindowsMin)</SupportedOSPlatformVersion>
    <RootNamespace>Lamha.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Shell_NotifyIcon's struct is laid out per architecture. Lamha ships x64 and ARM64 only, which share the
         64-bit layout (shellapi.h packs to 8 on every _WIN64 target), so x64's bindings serve both. -->
    <CsWin32PlatformTarget>x64</CsWin32PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lamha.Core\Lamha.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lamha.Windows.Tests" />
  </ItemGroup>
</Project>
